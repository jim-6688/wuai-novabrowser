{
  "installCommand": "echo skip-install",
  "buildCommand": "if exist dist rmdir /s /q dist & mkdir dist & xcopy /e /i /q assets dist\\assets\\ & xcopy /e /i /q download dist\\download\\ & copy /y index.html dist\\ & copy /y version.json dist\\ & exit /b 0",
  "outputDirectory": "./dist",
  "nodeVersion": "20.18.0",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/download/*.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
