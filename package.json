{
  "name": "nova-browser",
  "productName": "吾爱Nova浏览器",
  "version": "1.0.0",
  "private": true,
  "description": "多内核浏览器原型：Chromium / Gecko / IE(Trident) 内核切换，PC 与移动双端，内置广告拦截，支持 Chromium 插件与火狐扩展",
  "author": "WuAi",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "preview:ui": "node tools/preview.js",
    "check": "node tools/check-shell.js",
    "check:engines": "node tools/check-engines.js",
    "check:filters": "node tools/check-filters.js",
    "engines:fetch": "bash tools/fetch-engines.sh",
    "engines:check": "node tools/check-engines.js",
    "engines": "bash tools/fetch-engines.sh && node tools/check-engines.js",
    "filters:fetch": "bash tools/fetch-filters.sh",
    "filters:check": "node tools/check-filters.js",
    "filters": "bash tools/fetch-filters.sh && node tools/check-filters.js",
    "test": "node tools/check-shell.js && node tools/test-engines.js && node tools/test-adblock.js && node tools/test-engine-menu.js && node tools/test-downloader.js && node tools/test-downloads-ui.js && node tools/test-sniffer.js && node tools/test-sniffer-ui.js && node tools/test-nomedia.js && node tools/test-autopage.js && node tools/test-mobile-ui.js && node tools/test-builtin-userscript.js && node tools/test-newtab.js && node tools/test-bookmark-bar.js && node tools/test-favicon-cache.js && node tools/test-desktop-shortcut.js && node tools/test-ext-store.js && node tools/test-updater.js && node tools/test-downloader-degrade-qa.js",
    "test:downloader": "node tools/test-downloader.js",
    "test:downgrade-qa": "node tools/test-downloader-degrade-qa.js",
    "test:downloads-ui": "node tools/test-downloads-ui.js",
    "test:sniffer": "node tools/test-sniffer.js",
    "test:sniffer-ui": "node tools/test-sniffer-ui.js",
    "check:hidden": "electron tools/test-hidden-attr.js",
    "check:downloads": "electron tools/test-downloader-electron.js",
    "check:sniffer": "electron tools/test-sniffer-electron.js",
    "test:all": "npm test && npm run check:hidden && npm run check:downloads && npm run check:sniffer && npm run check:mobile",
    "shots": "electron tools/shot.js",
    "shots:win": "set ELECTRON_RUN_AS_NODE= && node_modules\\electron\\dist\\electron.exe --use-angle=swiftshader --use-gl=angle --disable-gpu-sandbox --no-sandbox tools\\shot.js",
    "test:nomedia": "node tools/test-nomedia.js",
    "test:autopage": "node tools/test-autopage.js",
    "test:mobile-ui": "node tools/test-mobile-ui.js",
    "test:newtab": "node tools/test-newtab.js",
    "test:bookmark-bar": "node tools/test-bookmark-bar.js",
    "check:mobile": "electron tools/test-mobile-electron.js",
    "icons": "electron tools/build-icons.js",
    "check:design": "node tools/check-design-board.js",
    "mobile:sync": "node tools/sync-mobile.js",
    "mobile:check": "node tools/check-mobile-sync.js",
    "mobile:test": "cd android-app && gradlew.bat testDebugUnitTest",
    "mobile:build": "npm run mobile:check && cd android-app && gradlew.bat assembleDebug",
    "pc:dir": "electron-builder --win --x64 --dir",
    "pc:build": "electron-builder --win --x64",
    "pc:zip": "node tools/make-zip.js",
    "publish:gitee": "node tools/publish-gitee.js",
    "test:favicon": "node tools/test-favicon-cache.js",
    "test:shortcut": "node tools/test-desktop-shortcut.js",
    "test:store": "node tools/test-ext-store.js"
  },
  "build": {
    "appId": "top.wuai.nova",
    "productName": "吾爱Nova浏览器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "assets/icon/nova.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "nova-pc-${version}-win-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "吾爱Nova浏览器"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "jsdom": "^24.0.0"
  }
}
