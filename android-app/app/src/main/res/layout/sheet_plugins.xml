<?xml version="1.0" encoding="utf-8"?>
<!-- 篡改猴（用户脚本）管理。同样独立成面板：装了什么、每条管不管用、出问题要能直接删。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <include layout="@layout/sheet_head" />

    <!-- 能力边界说明放在最上面：这个位置就是「为什么不能装 Chrome 扩展」的答案，
         放到下面会被跳过，而它恰恰是最容易被误解的一点。 -->
    <TextView
        android:id="@+id/plNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_4"
        android:textSize="11.5sp"
        android:lineSpacingExtra="4dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:id="@+id/plStat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/row"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:padding="14dp">

        <View
            android:layout_width="4dp"
            android:layout_height="30dp"
            android:background="@drawable/bar_accent" />

        <TextView
            android:id="@+id/plStatText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textColor="@color/text_2"
            android:textSize="12.5sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/plSwitch"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="62dp"
            android:gravity="center"
            android:background="@drawable/seg_track"
            android:textColor="@color/text_2"
            android:textSize="12.5sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/plEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="还没有安装插件"
        android:textColor="@color/text_4"
        android:textSize="12.5sp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="120dp"
        android:maxHeight="360dp">

        <LinearLayout
            android:id="@+id/plList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp" />
    </ScrollView>

    <TextView
        android:id="@+id/plInstall"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:background="@drawable/bg_primary_btn"
        android:text="从文件安装（.user.js）"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
