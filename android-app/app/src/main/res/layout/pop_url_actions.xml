<?xml version="1.0" encoding="utf-8"?>
<!--
  地址栏点开后弹出的动作：复制 / 分享该网站 / 截图 / 二维码 / 稍后读。

  为什么是贴在地址栏下方的浮层（PopupWindow），而不是项目里那套 openSheet：
  openSheet 是从屏幕底部滑上来的大面板，而这几个动作说的都是**地址栏里那串东西**，
  入口在顶部、面板从底部冒出来，视线要横穿整屏。浮层贴在下拉方向，
  点开地址栏、看动作、点一下，全程在拇指够得到的那一小块区域里。

  前两行两格一行（复制 / 分享、截图 / 二维码），第三行是整行宽的「稍后读」——
  它语义上是「存起来以后看」，和上面的「分享 / 转发」错开，所以单独占一行。
  宽度不变（仍是约 190dp，两个按钮一行），只是多了一行。
  中间那条 1dp 横线只是分隔行；每个按钮各自带 selectableItemBackground，
  所以是「若干可点区域」而不是「一张卡上停着几个词」。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_url_actions"
    android:padding="4dp">

    <!-- 第一行：复制 / 分享该网站 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/urlActCopy"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/ic_copy"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/url_act_copy"
                android:textSize="13sp"
                android:textColor="@color/text"
                android:maxLines="1" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:background="@color/border" />

        <LinearLayout
            android:id="@+id/urlActShare"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/ic_share"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/url_act_share"
                android:textSize="13sp"
                android:textColor="@color/text"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@color/border" />

    <!-- 第二行：截图 / 二维码 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/urlActShot"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/ic_screenshot"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/url_act_shot"
                android:textSize="13sp"
                android:textColor="@color/text"
                android:maxLines="1" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:background="@color/border" />

        <LinearLayout
            android:id="@+id/urlActQr"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/ic_qr"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/url_act_qr"
                android:textSize="13sp"
                android:textColor="@color/text"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@color/border" />

    <!-- 第三行：稍后读（整行宽，与上面两行错开，强调它是「存起来」而非「分享 / 转发」）。 -->
    <LinearLayout
        android:id="@+id/urlActRead"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ic_readlater"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/url_act_readlater"
            android:textSize="13sp"
            android:textColor="@color/text"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
