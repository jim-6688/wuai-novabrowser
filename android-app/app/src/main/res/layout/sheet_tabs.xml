<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <include layout="@layout/sheet_head" />

    <TextView
        android:id="@+id/tabTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_3"
        android:textSize="12sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp" />

    <!-- 两列网格。用 GridView 而不是 LinearLayout 手动拼：
         十几个标签手动拼出来的高度会把弹层顶出屏幕，而 GridView 自己管滚动。

         这里的 260dp 只是「真实行高测出来之前」的初始值，最终高度由
         MainActivity#showTabSheet 按实测行高设置 —— 写死 260dp 装不下两行
         （两张卡片加行间距要 272dp），第二行域名那半截会被切掉一截。 -->
    <GridView
        android:id="@+id/tabGrid"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:numColumns="2"
        android:columnWidth="150dp"
        android:horizontalSpacing="8dp"
        android:verticalSpacing="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:stretchMode="columnWidth"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/tabNew"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:background="@drawable/bg_primary_btn"
        android:text="@string/action_new_tab"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
