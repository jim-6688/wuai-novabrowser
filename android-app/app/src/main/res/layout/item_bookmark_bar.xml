<?xml version="1.0" encoding="utf-8"?>
<!--
  收藏夹栏里的一格。

  与列表版 item_bookmark 的差别只有一处：那边右端是 × 删除键、占 34dp 固定宽，
  这里删除走长按（格子里塞不下），所以右边不占位。

  两行（标题 + 网址）与桌面端那条栏对齐 —— 网址排在标题下方而不是只塞进
  contentDescription：横排一长条书签时，光看标题分不清「知乎」是
  www.zhihu.com 还是 zhuanlan.zhihu.com，而分错了就得点进去才发现。

  高度从 28dp 涨到约 36dp：横栏只有一行高，字号比列表版各小一号
  （12sp / 9.5sp 对 13.5sp / 11sp），两行也不显得臃肿。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="36dp"
    android:paddingStart="7dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_marginEnd="4dp">

    <TextView
        android:id="@+id/bmbFav"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_fav_letter"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_3"
        android:textSize="9sp"
        android:textStyle="bold"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bmbTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="136dp"
            android:textColor="@color/text_2"
            android:textSize="12.5sp" />

        <!-- 网址。hostOf 之后的主机名，不带 https:// 与 www. ——
             整条路径写进横栏会把这一格撑得很宽，而横栏的可用宽度有限。 -->
        <TextView
            android:id="@+id/bmbUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="136dp"
            android:textColor="@color/text_4"
            android:textSize="9.5sp" />
    </LinearLayout>
</LinearLayout>