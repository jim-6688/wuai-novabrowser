<?xml version="1.0" encoding="utf-8"?>
<!-- 推荐脚本库里的一个条目：名称 / 验证状态 / 来源 / 说明 / 已知限制 / 安装按钮。
     比「已装插件」那行多两样东西 —— 验证徽章与已知限制。
     它们存在的理由：清单里的脚本大多没在包内验证过，用户有权在点安装前
     就知道「这条没人确认过 @grant 声明」，而不是装完发现不生效。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/row"
    android:layout_marginBottom="8dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ctName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/ctBadge"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/accent"
            android:textSize="10.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ctCredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/text_4"
        android:textSize="10.5sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/ctDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_3"
        android:textSize="11.5sp"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:ellipsize="end" />

    <!-- 已知限制用告警色。它是「装之前该知道的事」，不是普通说明文字。 -->
    <TextView
        android:id="@+id/ctCaution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/danger"
        android:textSize="10.5sp"
        android:lineSpacingExtra="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ctAction"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:background="@drawable/btn_mini"
        android:text="安装"
        android:textColor="@color/accent"
        android:textSize="11.5sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />
</LinearLayout>
