<?xml version="1.0" encoding="utf-8"?>
<!--
  通用的「从列表里选一个」面板。搜索引擎与内核说明都用它。

  原来是 sheet_engine 一个布局被三处复用（内核、搜索引擎、规则订阅），
  结果那三处的需求已经分开了：内核要「真/假」标记，搜索要「选一个」，
  订阅要「当前是哪个 + 说明」。硬塞进一份就到处都是 if。
  这份只保留三者真正共有的东西：一个头 + 一个列表。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <include layout="@layout/sheet_head" />

    <TextView
        android:id="@+id/pickerNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_4"
        android:textSize="11.5sp"
        android:lineSpacingExtra="4dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="140dp"
        android:maxHeight="420dp">

        <!--
          同 sheet_bookmarks：一组白卡 + 行间一条灰线（showDividers="middle"）。
          这一页被搜索引擎 / 主题配色 / 网页字号 / 内核 四处复用，
          所以这一改四处一起变 —— 它们本来就该长得一样。
        -->
        <LinearLayout
            android:id="@+id/pickerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_menu_group"
            android:divider="@drawable/divider_row"
            android:showDividers="middle" />
    </ScrollView>
</LinearLayout>
