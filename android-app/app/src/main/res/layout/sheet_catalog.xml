<?xml version="1.0" encoding="utf-8"?>
<!-- 推荐脚本库。清单随包内置，但一条都不装 —— 用户点哪条才装哪条。
     与「插件面板」分开成两级，是因为这两件事的语义不同：
     那个面板是「我已经装了什么」，这里是「我可以装什么」。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <include layout="@layout/sheet_head" />

    <!-- 两条免责说明放最上面：本体不入包（只存地址）、以及未验证是什么意思。
         这两点如果不说清楚，用户会把「未验证」直接读成「不推荐」。 -->
    <TextView
        android:id="@+id/ctNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_4"
        android:textSize="11.5sp"
        android:lineSpacingExtra="4dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="160dp"
        android:maxHeight="420dp">

        <!--
          同 sheet_bookmarks：一组白卡 + 行间一条灰线（showDividers="middle"）。

          这一页的列表里除了脚本行还有「分组小标题」（推荐 / 实用 / 增强…），
          标题同样是这个列表的子 View，于是它下面也会有一条线 —— 留着：
          它正好把「这一类的名字」与「这一类的内容」分开，读起来是标题的下划线，
          而不是没画完的分隔线。
        -->
        <LinearLayout
            android:id="@+id/ctList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:background="@drawable/bg_menu_group"
            android:divider="@drawable/divider_row"
            android:showDividers="middle" />
    </ScrollView>
</LinearLayout>
