<?xml version="1.0" encoding="utf-8"?>
<!--
  书签（收藏）管理。独立成面板：收藏了什么、每条点开即去、不要的能直接删。
  和插件面板同一个骨架，因为「一列条目 + 空态 + 清空」这种模式在这里又用了一遍。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <include layout="@layout/sheet_head" />

    <TextView
        android:id="@+id/bmEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/bookmark_empty"
        android:textColor="@color/text_4"
        android:textSize="12.5sp"
        android:lineSpacingExtra="4dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="120dp"
        android:maxHeight="420dp">

        <!--
          一整组书签包进一张白卡（bg_menu_group），行与行之间一条 1dp 的灰线。
          与设置页/菜单/工具箱是同一套「灰底 + 白卡 + 行间细线」的语言。

          分隔线用 LinearLayout 自带的 showDividers="middle"，而不是每行画下边框：
          写在下边框上，最后一行下面也会留一条 —— 那条线下面已经没有内容了，
          看着像是列表被截断。middle 的语义正好是「只在行与行之间」。
        -->
        <LinearLayout
            android:id="@+id/bmList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_menu_group"
            android:divider="@drawable/divider_row"
            android:showDividers="middle" />
    </ScrollView>

    <TextView
        android:id="@+id/bmClear"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:background="@drawable/row"
        android:text="清空收藏"
        android:textColor="@color/text_2"
        android:textSize="14sp" />
</LinearLayout>
