<?xml version="1.0" encoding="utf-8"?>
<!--
  书签（收藏）管理。独立成面板：收藏了什么、每条点开即去、不要的能直接删。
  和插件面板同一个骨架，因为「一列条目 + 空态 + 清空」这种模式在这里又用了一遍。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <include layout="@layout/sheet_head" />

    <TextView
        android:id="@+id/bmEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/bookmark_empty"
        android:textColor="@color/text_4"
        android:textSize="12.5sp"
        android:lineSpacingExtra="4dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="120dp"
        android:maxHeight="420dp">

        <LinearLayout
            android:id="@+id/bmList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp" />
    </ScrollView>

    <TextView
        android:id="@+id/bmClear"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:background="@drawable/row"
        android:text="清空书签"
        android:textColor="@color/text_2"
        android:textSize="14sp" />
</LinearLayout>
