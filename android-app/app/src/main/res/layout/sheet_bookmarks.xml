<?xml version="1.0" encoding="utf-8"?>
<!--
  书签（收藏）管理。独立成面板：收藏了什么、每条点开即去、不要的能直接删。
  和插件面板同一个骨架，因为「一列条目 + 空态 + 清空」这种模式在这里又用了一遍。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <include layout="@layout/sheet_head" />

    <!-- 长按能编辑这条提示必须写出来：长按不是自明的手势，不写没人会去试，
         等于这个功能不存在。同理，右上角 × 只删不收 —— 那句「长按」也顺带说明
         「删除不用长按」，两个动作用两种手势，互不打架。 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="点一下即前往 · 长按可编辑标题和网址"
        android:textColor="@color/text_4"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/bmEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/bookmark_empty"
        android:textColor="@color/text_4"
        android:textSize="12.5sp"
        android:lineSpacingExtra="4dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="120dp"
        android:maxHeight="420dp">

        <!--
          一整组书签包进一张白卡（bg_menu_group），行与行之间一条 1dp 的灰线。
          与设置页/菜单/工具箱是同一套「灰底 + 白卡 + 行间细线」的语言。

          分隔线用 LinearLayout 自带的 showDividers="middle"，而不是每行画下边框：
          写在下边框上，最后一行下面也会留一条 —— 那条线下面已经没有内容了，
          看着像是列表被截断。middle 的语义正好是「只在行与行之间」。
        -->
        <LinearLayout
            android:id="@+id/bmList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_menu_group"
            android:divider="@drawable/divider_row"
            android:showDividers="middle" />
    </ScrollView>

    <!--
      导入：手机上没有「读取别的浏览器书签」的公共接口（Chrome 的把书签放在账号里，
      没有可查的 ContentProvider），所以走通用的一步 —— 选 Chrome / Edge / Firefox
      导出的书签 HTML（三者是同一个 Netscape 格式），也认本产品自己导出的 JSON。
      放在「清空」上面：导入是收集动作，清空是破坏动作，破坏性的那个永远在最下面。
    -->
    <TextView
        android:id="@+id/bmImport"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:background="@drawable/row"
        android:text="导入书签（从其他浏览器）"
        android:textColor="@color/text_2"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/bmClear"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:background="@drawable/row"
        android:text="清空收藏"
        android:textColor="@color/text_2"
        android:textSize="14sp" />
</LinearLayout>
