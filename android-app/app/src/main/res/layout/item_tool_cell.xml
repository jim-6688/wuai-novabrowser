<?xml version="1.0" encoding="utf-8"?>
<!--
  工具面板里的一格：图标在上、名称在下，等宽四列（2026-10-25 由三列改四列，
  行数随之从三行变两行，见 sheet_tools.xml 注释）。

  为什么不复用 item_menu.xml：那一行是「左图标 + 标题 + 副标题 + 右取值/箭头」的
  横向结构，横向张力全在文字那一侧，靠 layout_weight 把文字撑开；宫格格子是纵向、
  等宽的，两者除了都有一枚图标之外没有共同点。硬用一份的话，每处调用都要手动把
  一半子 View 压成 GONE，那份「可选三层」的灵活性反而变成负担。

  根节点不带 id 也可以：<include android:id="..."> 总会覆盖到根 View 上。
  但仍显式写一个，免得将来有人直接拿它当普通布局 inflate 时找不到 id。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cellRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="84dp"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 与顶栏三键、底栏五格同一尺幅（@dimen/icon_action = 26dp）。
         宫格、底栏、顶栏在同一屏里并排出现，任何一处单独写数值都会立刻
         变成「有的图标大、有的小」——这正是尺幅令牌存在的理由。 -->
    <ImageView
        android:id="@+id/cellIcon"
        android:layout_width="@dimen/icon_action"
        android:layout_height="@dimen/icon_action"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <!-- 单行截断：宫格的宽度是均分的，长名字只能省略号收尾，
         让它换行会把同一行的格子撑成不同高度。 -->
    <TextView
        android:id="@+id/cellLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:textColor="@color/text_2"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
