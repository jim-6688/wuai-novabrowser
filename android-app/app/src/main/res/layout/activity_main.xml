<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面。结构与桌面端 [data-layout="mobile"] 下的 shell.html 一致：
    顶：工具栏（搜索 + 地址栏 + 收藏 + AI）；滚动时整行收起。
        内置新标签页上这一行的内容整体隐去（页内已经有搜索框了），
        但行本身留着，页面内容不会因为顶栏有无而上下跳 —— 见 MainActivity#applyChromeFor。
    中：WebView（容器 RefreshHost 负责下拉刷新）+ 加载进度 + 提示条
    底：五格等宽底栏（.mobilebar）；滚动时原位置换成胶囊搜索框（见 bottomRow）

  刻意不给任何硬编码颜色，全部走 @color/*，这样 values-night 一换就整体变深色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- ============ 顶部工具栏 ============
         一行：搜索 + 地址栏 + 收藏 + AI。

         原先这里还有第二行（阅读 / 观影 / 翻译 / AI 四个功能键）。撤掉的理由是
         那一行把「一屏直达」当成了唯一价值，代价却是顶栏常驻 48dp 的厚度 ——
         而那四个功能都在工具箱里有行（sheet_tools 的 toolRead / toolTranslate /
         toolMovie），下滑一次就到（AI 助手与主菜单后来也各自撤了工具箱里的副本 —
         它们在顶栏有常驻入口）。顶栏从 96dp 收回 48dp，网页多出一行。

         滚动时这一整块收起（setVisibility(GONE)），高度还给网页。
         内置新标签页上整块收掉（GONE，见 MainActivity#applyChromeFor）。
    -->
    <!--
      背景刻意**不在这一层**，改由内层 topBar 自己带：
      曾经这个 FrameLayout 有 android:background="@color/surface"（白），
      而新标签页上 topBar 是收掉的 —— 于是那一行没了、白色却还留着，
      屏幕上就是状态栏下方横着一条 48dp 的白带（内容什么都不剩，只剩底色）。
      背景跟着「真的有内容的那一行」走，才不会留下一块没有主人的底色。
    -->
    <FrameLayout
        android:id="@+id/topRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!--
          这里原来有一条 1dp 的硬分隔线（@color/border）。撤掉，改由 elevation 的
          投影来说「工具栏浮在网页上面」—— 两条一起留着，边上就成了一道双线。

          4dp → 8dp：4dp 的投影在浅色底上几乎看不见（当初那条硬线就是为了补这件事
          才加的），8dp 才有明确的悬浮感。底栏用同一个值，两条看起来才是同一套东西。

          elevation 与背景都已挪到内层 topBar 上（2026-10）：这一层现在只是一个
          装它的壳，而新标签页上它是空的 —— 背景与阴影留在壳上，就会在内容都收走
          之后留下一条带底色和阴影的空带。
        -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶栏那一行：品牌标 + 地址栏 + 收藏 + AI。
                 这一行的 id 是 topBar —— 内置新标签页上整行收掉
                 （View.GONE，见 MainActivity#applyChromeFor）。

                 白底挂在这**一行**上，而不是外层那个 FrameLayout：
                 只有真正有内容的那一行才该有底色。挂在外层的话，新标签页上
                 这一行没了、外层还在，用户看到的就是一条什么都没有的
                 白带（状态栏下方横着的那个白框）。 -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:elevation="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp">

                <!-- 品牌标识：点开主菜单。
                     上一版这里是搜索按钮（点一下聚焦地址栏），用户反馈「意义不大」——
                     地址栏本来就在这一行正中间，点两下就聚焦了；这一格放在最左端
                     占的是从「界面从哪开始」读起来的头一个位置，而品牌标回答的正是
                     「这是哪个应用」。搜索的起点交给底栏上划那条搜索胶囊（见
                     BottomBarReveal），那里才是真正的「我想搜点什么」。

                     padding比右边几个键小 1dp：logo 本身有方形底，
                     四周留白一多就显得比旁边的搜索键小一号。 -->
                <ImageButton
                    android:id="@+id/btnBrand"
                    android:layout_width="@dimen/tap_action"
                    android:layout_height="@dimen/tap_action"
                    android:layout_marginEnd="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_desc_brand"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:src="@drawable/ic_brand" />

                <!-- 地址栏 -->
                <FrameLayout
                    android:id="@+id/omniboxWrap"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1">

                    <EditText
                        android:id="@+id/urlBar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/omnibox"
                        android:elevation="2dp"
                        android:hint="@string/omnibox_hint"
                        android:textSize="14sp"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_4"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:maxLines="1"
                        android:inputType="textUri|textNoSuggestions"
                        android:imeOptions="actionGo|flagNoExtractUi"
                        android:selectAllOnFocus="true" />
                </FrameLayout>

                <!-- 收藏（书签）按钮 -->
                <ImageButton
                    android:id="@+id/btnStar"
                    android:layout_width="@dimen/tap_action"
                    android:layout_height="@dimen/tap_action"
                    android:layout_marginStart="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_desc_star"
                    android:scaleType="centerInside"
                    android:padding="7dp"
                    android:src="@drawable/ic_star" />

                <!-- 收藏夹栏的唤出键已撤掉 —— 它收进底栏工具箱里那一格了
                     （sheet_tools 的 toolBmBar）。顶栏每一格都要争宽度，
                     而这一格与左端搜索、右端 AI 相比并不常用，让位给地址栏更值。
                     下面那个 include 出来的 bookmarkBar 本身不动：
                     它是「按需唤出」的那条横栏，唤出入口换了地方，栏还是同一条。 -->

                <!-- AI 助手。原来在顶栏第二行（那一行已撤掉），现在是顶栏最右一格。
                     图标本身就是品牌渐变，与左端的搜索按钮一蓝一绿呼应，一眼能认出
                     「这一格是去别处做一件事」。 -->
                <ImageButton
                    android:id="@+id/btnAi"
                    android:layout_width="@dimen/tap_action"
                    android:layout_height="@dimen/tap_action"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_desc_ai"
                    android:scaleType="centerInside"
                    android:padding="7dp"
                    android:src="@drawable/ic_ai" />
            </LinearLayout>

            <!-- 收藏夹栏（原 bookmarkBar）已整体移除。

                 去掉的理由：它是一条「按需唤出」的横栏，代价却是**永久占掉
                 地址栏下方一行** —— 而那条横幅无论收着还是展开，网页视口都要
                 让出它的高度。手机上每一行高度都金贵，而「一次点到常去站点」
                 这件事，书签列表（工具箱 → 收藏夹）已经做得更好：能看全、
                 带网址、能点 × 删。横栏能给的只有「一眼扫到」，不值这一行。

                 替代路径：底栏工具箱里那一格「收藏夹」直接开列表。

                 这条栏原本还牵连三处，现在一并退场（不留「控制一个不存在的东西」
                 的开关）：
                   · MainActivity 里 renderBookmarkBar / bookmarkBarCell /
                     applyBookmarkBarVisibility / syncBmBarButton / bmBarOpen
                   · 设置里的「收藏夹栏」开关（它的说明本就写着「点一下在地址栏
                     下方拉出一条书签栏」）
                   · res/layout/item_bookmark_bar.xml 与 BookmarkBar 里只为它
                     存在的 expanded() / label() / letter() / host()

                 topBar 之后的那个 LinearLayout 保留（还要装别的东西）。 -->

        </LinearLayout>

    </FrameLayout>

    <!-- ============ 更新提示条 ============ -->
    <!--
      夹在顶栏与网页之间：它说的是「应用本身」的状态，不是当前这个网页的状态，
      所以不该挤进网页区内部；而挂到最上面或最下面，又会被系统栏 / 底栏的
      视觉重量压住。放在这里，它是顶栏的自然延伸。

      include 必须显式写 id：不写的话拿不到这一条的引用。它内部所有子 View 的 id
      都挂在同一个命名空间里，很容易误以为 findViewById(R.id.updateBar) 能直接拿到 ——
      拿不到，那样返回的是 null，而这个错要到真机上「更新条死活不出现」才会被发现。
    -->
    <include
        layout="@layout/bar_update"
        android:id="@+id/updateBar" />

    <!-- ============ 网页区 ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!--
          WebView 由代码注入（见 MainActivity#mountMain），不写在布局里。

          写在布局里的话，setContentView 每次执行（也就是每次从弹层返回）
          都会 inflate 出一个新的 WebView 实例，而那个实例不会被 destroy()，
          于是每开关一次弹层就泄漏一个 —— WebView 持有的是 native 内存，
          攒几十个就能把进程拖崩。

          这个容器本身是 {@link top.wuai.nova.RefreshHost}，不是裸 FrameLayout：
          下拉刷新要靠触摸事件拦截，而拦截必须在「包着 WebView 的那一层」做
          （理由见 RefreshHost 的类注释）。实例仍由 MainActivity 持有并搬进搬出：
          既杜绝了泄漏，也保住了页面本身（滚动位置、表单、正在播放的音频）。
        -->
        <top.wuai.nova.RefreshHost
            android:id="@+id/webHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!--
              下拉刷新的指示器。

              用「球」而不是「箭头」：它要从网页上沿滑下来，圆形在任何高度都成立；
              箭头形状在滑动途中会被读成「一个没对齐的图标」。

              隐藏时整体移到本容器上沿之外（负位移），靠 FrameLayout 的裁剪看不见 ——
              而不是用 visibility 切换。用 visibility 的话就没法做出「跟着手指滑下来」
              这件事，那正是下拉刷新唯一的进度反馈。

              小 spinner 与箭头互斥：拉的过程中显示箭头（跟着手指转），
              真开始刷新了换成系统 spinner（由系统负责转，不用自己写动画）。
            -->
            <FrameLayout
                android:id="@+id/refreshBall"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_refresh_ball"
                android:elevation="4dp"
                android:visibility="gone"
                android:alpha="0">

                <ImageView
                    android:id="@+id/refreshArrow"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_reload"
                    android:contentDescription="@string/content_desc_pull_refresh" />

                <ProgressBar
                    android:id="@+id/refreshSpinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/brand"
                    android:visibility="gone" />
            </FrameLayout>
        </top.wuai.nova.RefreshHost>

        <!-- 加载进度。高度 2dp 是桌面端进度条高度令牌 bar-h 的对应值，
             粗了会跟内容抢注意力，细到看不见又等于没有。 -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/brand"
            android:progressBackgroundTint="@android:color/transparent" />

        <!-- 状态条：拼页进度 / 降级提示 / 无图命中。
             桌面端那个 shrink-to-fit 的截断坑在原生里不存在（原生按 layout 算宽），
             但仍然要 maxLines=2，否则一句长的降级原因会把进度条顶下去。

             marginBottom 60dp = 底栏高度：底栏改成压在网页上之后，凡是对 bottom
             对齐的东西都会钻到它底下去（这一条和下面的无图标记都是）。 -->
        <TextView
            android:id="@+id/statusStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="60dp"
            android:background="#E6171A22"
            android:textColor="#F2F4F8"
            android:textSize="12sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- 无图模式的常驻标记。放在地址栏下方而不是状态条里，
             因为它是「当前生效的档位」，不是「刚刚发生的事」，关掉了就不该占地方。 -->
        <TextView
            android:id="@+id/noImageChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="72dp"
            android:background="@drawable/chip_pill"
            android:text="@string/status_noimage"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <!--
          强制更新时盖在网页上的遮罩。

          为什么需要这一层：「强制」如果只体现在「× 按钮不见了」，用户照样可以
          刷一整天的网页，只是上面多挂了一行字 —— 那叫提示，不叫强制。
          把网页区盖住、把「继续用旧版」这条路堵上，才对得起 mandatory 这个标记。

          它只盖网页区，不盖顶栏和底栏：地址栏还能看出当前在哪个站，
          底栏还能退出应用。要挡住的是「继续用」，不是「把人关起来」。

          颜色直接写 #A6000000 而不走 @color 令牌：这是一层纯黑遮罩，
          深浅两个主题下都该是同样的黑，走令牌反而要维护两份等值的颜色
          （statusStrip 那处的硬编码也是同一个道理）。
        -->
        <View
            android:id="@+id/updateGuard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A6000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ============ 底栏（两态叠放） ============
         这一行有两种形态，同一行里叠着、滚动时交叉淡入淡出：
           常态   = mobileBar     —— 五格纯图标（后退 / 主页 / 标签 / 刷新 / 工具），
                                      2026-10-25 起是浮在网页上的玻璃胶囊，不再通栏
           滚动中 = searchCapsule —— 整条换成胶囊搜索框

         为什么搜索框搬到这里（原先是放在顶栏那一行的）：
         底栏隐去时它那 68dp 是留着的（用 INVISIBLE 而不是 GONE，图的是不改布局、
         不推网页），于是屏幕下方多出一条谁也没用的空白。与其让它空着，
         不如把「滚动时唯一还要用的东西」放进去 —— 手指刚划完的地方，
         本来也是拇指最顺的位置。

         行高恒定（68dp）的做法与顶栏原先一样：两个子 View 互相覆盖，
         「行高 = 最高的那个」，胶囊 40dp < 68dp，所以它在 GONE 与 VISIBLE
         之间怎么切都不会改这一行的高度 —— 网页不会被推一下。

         68dp = 58dp 胶囊 + 10dp 离屏底的悬浮量（对齐设计稿 .mbar 的 bottom:10px：
         胶囊是浮起来的，不是贴着屏幕下沿的）。本机不走 edge-to-edge，布局下沿
         本来就在系统导航栏之上，这 10dp 浮得开。
    -->
    <!--
      这一条**压在网页上**，不是把网页推上去的一行。

      「压在网页上」靠上面那个 layout_marginTop="-68dp"：负的外边距让这一条
      从网页区的下沿再往上提 68dp，正好盖住网页最后一条；LinearLayout 里后画的
      兄弟盖在先画的上面，所以它是盖上去而不是把网页挤走。负值必须与 height 相等
      （都是 68dp），改高度时这里要跟着改。

      底色**随形态切**（见 MainActivity#applyBottomBarGround）：
        五格工具栏时 = 行本身透明，玻璃底长在胶囊自己身上（bg_bottom_capsule）
        胶囊搜索框时 = @color/surface_translucent（行的玻璃条，搜索胶囊浮在它上面）

      2026-10-25 起五格也改半透明：它曾经是实底，理由是「常驻的一条，页面文字
      会从图标缝里透出来，读起来像脏」。设计稿把这条理由否了 —— 底栏与顶栏是
      同一套材质（上下两条才像一对），而且玻璃只占中间一条窄胶囊、网页从它
      两侧穿过去，不是整个通栏压在页面上。行自己不再出底色、也不再出投影：
      它是一条通栏矩形，投影会在胶囊四周露出一圈通栏的影子。投影由胶囊
      （mobileBar 的 elevation）和搜索胶囊各自出。

      初态（工具栏形态）行就是透明的 —— 写在布局里而不是等代码纠正，
      否则冷启动第一帧会闪一下通栏底色。

      代价说清楚：网页最底下 68dp 会被挡住。所以 MainActivity#injectBarInset
      会给页面补一条同样高度的 padding-bottom，把最后一行还回来。
    -->
    <FrameLayout
        android:id="@+id/bottomRow"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="-68dp"
        android:background="@android:color/transparent">

        <!--
          五格底栏，胶囊形（2026-10-25，对齐设计稿 mobile-spring-demo.html 的 .mbar）：
          按内容收紧、水平居中、离屏底悬浮 10dp，玻璃底 + 投影，
          与顶栏同一套材质，上下两条才像一对。

          尺寸走 dimens 里那一套（mb_capsule_h/radius、mb_cell_w/h、mb_tab_block_w/h）：
          圆角必须正好是半个身高，端头才是正圆 —— 差一个 dp 就退回「圆角矩形」，
          那正是这次修掉的旧形态。

          格子从 0dp+weight 撑满通栏改成固定 56×46dp：胶囊按内容收宽，
          weight 在没有剩余空间的 wrap_content 父容器里不起作用，写固定值才诚实。
          注意 android:gravity="center_vertical"：格子 46dp 比胶囊 58dp 矮一截，
          横向 LinearLayout 的子 View 默认顶端对齐，不写这句整行格子（连中间
          品牌块）会齐齐偏高 —— 2026-10-25 用户报「标签图标底色靠上」就是它。

          投影由本 View 自己的 elevation 出；底栏那一行（bottomRow）是通栏矩形，
          由它出投影会在胶囊四周露一圈通栏影子，所以行的 elevation 已撤掉。
          两端格子的矩形按背景会探出胶囊的圆弧，靠 clipToOutline 裁掉
          （在 MainActivity 绑定 mobileBar 处开）。
        -->
        <LinearLayout
            android:id="@+id/mobileBar"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/mb_capsule_h"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="@drawable/bg_bottom_capsule"
            android:elevation="12dp">

            <!--
              各格用 <include> 复用同一份布局。include 上必须显式写 id：
              不写的话被包含布局的根 id（btnBox）会原样冒上来，几格一模一样的 id，
              findViewById 只会拿到第一个 —— 那就是「几个按钮全绑成同一个动作」这种
              能编译能运行、只是完全不对的 bug。
              尺寸也在这里显式写全（56×46dp，见 mb_cell_w/h）：被包含布局的根是
              0dp+weight 的通栏写法，胶囊要的是固定格。
            -->
            <include layout="@layout/item_mb_back" android:id="@+id/item_mb_back"
                android:layout_width="@dimen/mb_cell_w" android:layout_height="@dimen/mb_cell_h" />
            <include layout="@layout/item_mb_home" android:id="@+id/item_mb_home"
                android:layout_width="@dimen/mb_cell_w" android:layout_height="@dimen/mb_cell_h" />

            <!--
              中间那格是标签页，底栏上唯一的「主操作」：格外壳固定 56×46dp，里面一块
              46×48dp 的品牌色实底（mb_tab_block_w/h）—— 比格子宽、上下各探出 1dp，
              主操作比周围格胖一圈，但不炸满整格。2026-10-25 随底栏胶囊化从
              26×26 放大回来，对齐设计稿 .cell.pri::before；圆角 17dp 见 bg_tab_brand。

              它原先是一颗 56dp 的品牌渐变主按钮；五格改等宽后被压成一颗小图标壳，
              计数徽标成了这一格唯一的有色元素。如今块放大回来，「现在开着几个标签」
              重新成为底栏上被强调的一粒。

              徽标挂在块壳里、贴块壳右上角，而不是挂在这一格上：挂在格上会按整格
              （高度随胶囊变、宽度固定）定位，它在不同机型上会飘。壳要
              clipChildren=false，否则探出壳外的半个徽标会被裁掉；格外壳也要
              clipChildren=false，管的是块比格高出那 1dp。
            -->
            <FrameLayout
                android:id="@+id/mbTabs"
                android:layout_width="@dimen/mb_cell_w"
                android:layout_height="@dimen/mb_cell_h"
                android:clipChildren="false"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <!--
                  这一格的底色是品牌色实底（bg_tab_brand）：2026-10-24 由官网徽标
                  那套渐变改成纯色 —— 顶栏品牌钮是渐变（代表「这个应用」），这一格
                  是纯色（代表「这个动作」），两个主色挨在一起才分得开谁是谁；
                  2026-10-25 圆角随块放大从 8dp 改到 17dp。
                  块 46×48dp，比格外壳高出 1dp —— 靠两层 clipChildren=false 放行。
                -->
                <FrameLayout
                    android:layout_width="@dimen/mb_tab_block_w"
                    android:layout_height="@dimen/mb_tab_block_h"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_brand"
                    android:elevation="2dp"
                    android:clipChildren="false">

                    <ImageView
                        android:layout_width="@dimen/icon_action"
                        android:layout_height="@dimen/icon_action"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_tabs"
                        android:tint="#FFFFFF"
                        android:contentDescription="@string/mb_tabs" />

                    <TextView
                        android:id="@+id/mbTabCount"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:minWidth="16dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:gravity="center"
                        android:text="1"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand"
                        android:background="@drawable/bg_tab_count"
                        android:translationX="2dp"
                        android:translationY="-3dp" />
                </FrameLayout>
            </FrameLayout>

            <include layout="@layout/item_mb_reload" android:id="@+id/item_mb_reload"
                android:layout_width="@dimen/mb_cell_w" android:layout_height="@dimen/mb_cell_h" />
            <!-- 第五格「工具箱」：弹工具面板（下载 / 阅读模式 / 翻译网页 / 观影模式 /
                 篡改猴 / 广告拦截 / 网页安全 / 收藏夹）。顶栏那个工具图标撤掉之后，
                 这里是工具的唯一下沉入口。 -->
            <include layout="@layout/item_mb_tools" android:id="@+id/item_mb_tools"
                android:layout_width="@dimen/mb_cell_w" android:layout_height="@dimen/mb_cell_h" />
        </LinearLayout>

        <!--
          滚动态的胶囊搜索框。顶栏整行收起后，搜索入口落到这里。

          刻意用 surface + 品牌色描边（bg_search_capsule），与常态的 omnibox
          （surface_2 灰底无边框）区分开 —— 一眼能看出「现在这一格是搜索状态」。

          40dp 高：底部这一行是拇指的自然落点，比它原先在顶栏时的 34dp 放大一档更好按，
          也刚好放下与底栏同尺幅的 26dp 放大镜（上下各留 7dp）；
          同时 40 < 60（行高），所以它显隐不会改本行高度。

          初始 gone + alpha=0：不进场时它不该吃掉任何触摸。
          位移由代码给（见 MainActivity#applyReveal），从本行下沿滑进来。
        -->
        <LinearLayout
            android:id="@+id/searchCapsule"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_capsule"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:elevation="6dp"
            android:visibility="gone"
            android:alpha="0">

            <ImageView
                android:id="@+id/capsuleSearch"
                android:layout_width="@dimen/icon_action"
                android:layout_height="@dimen/icon_action"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search_hint" />

            <EditText
                android:id="@+id/capsuleInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:textColor="@color/text"
                android:textColorHint="@color/text_4"
                android:textSize="14sp"
                android:maxLines="1"
                android:inputType="textUri|textNoSuggestions"
                android:imeOptions="actionSearch|flagNoExtractUi" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>