<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面。结构与桌面端 [data-layout="mobile"] 下的 shell.html 一致：
    顶：工具栏（内核标识 + 首页 + 收藏 + 地址栏 + 刷新 + AI）；滚动时整行收起
    中：WebView（容器 RefreshHost 负责下拉刷新）+ 加载进度 + 提示条
    底：五格底栏（.mobilebar）；滚动时原位置换成胶囊搜索框（见 bottomRow）

  刻意不给任何硬编码颜色，全部走 @color/*，这样 values-night 一换就整体变深色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- ============ 顶部工具栏 ============
         常态：内核标识 + 首页 + 收藏 + 地址栏 + 刷新 + AI。

         滚动时这一行<b>整行收起</b>（setVisibility(GONE)），高度还给网页。
         以前的做法是「行留着、把内容换成胶囊搜索框」，好处是行高恒定不推网页，
         坏处是搜索框和网页顶端挤在同一块区域，而底部五格栏隐去后留下一条空白没人用。

         现在两件事对调：顶栏收起让出 52dp，搜索框搬到下面底栏那一行
         （见文件末尾的 bottomRow）—— 滚动时屏幕上只剩「网页 + 底部一条搜索框」。
    -->
    <FrameLayout
        android:id="@+id/topRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="1dp">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- 内核标识：小圆点 + 当前引擎名。
                 它现在是**只读**的，不可点。
                 以前这里挂着一个选择动作，但移动版实际只有系统 WebView 一档真的内置
                 （其余两档是没带内核的、或只换 UA 的兼容层）——
                 给一个只有一个选项的按钮叫「内核选择」，等于用一个假选择骗用户。
                 所以动作去掉，标识留着：随时能看到自己跑在哪一档上，这一条还是有用的。 -->
            <LinearLayout
                android:id="@+id/engineChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <View
                    android:id="@+id/engineDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/engineLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mb_engine"
                    android:textSize="11sp"
                    android:textColor="@color/text_2"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 首页按钮。放在地址栏左侧而不是底栏：
                 底栏是五格硬约束 —— 320dp 机型上每格已经贴着 44px 触控下限，
                 加第六格会掉到线下；而工具栏这里原本只有一个只读的内核标识，
                 位置是空的，地址栏让出 34dp 之后还剩 200dp 以上。
                 这也是 UC / QQ / 夸克们的惯例位置：回家键挨着地址栏，不占拇指动线。

                 34dp → 40dp、padding 8dp → 9dp（图标本体 22dp）：
                 顶栏行高随之从 6+34+6=46dp 变成 6+40+6=52dp，
                 正好等于设计板 .mtoolbar 的 52px —— 代码这边一直矮了 6dp。 -->
            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_home"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:src="@drawable/ic_home" />

            <!-- 收藏（书签）按钮。和首页键挨着，都在地址栏左侧：
                 两个「一抬拇指就够到」的入口，不挤占底栏的触控预算。
                 图标随当前页是否收藏在描边 / 实心之间切换。 -->
            <ImageButton
                android:id="@+id/btnStar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_star"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:src="@drawable/ic_star" />

            <!-- 地址栏。id 是给「复制 / 分享」那个浮层的锚点用的：
                 PopupWindow 要挂在一个 View 上定位，而浮层该贴的是**整个地址栏**
                 而不是里面那个 EditText —— 拿 EditText 当锚点，它的光标与
                 padding 会让浮层偏出去几个 dp。 -->
            <FrameLayout
                android:id="@+id/omniboxWrap"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1">

                <EditText
                    android:id="@+id/urlBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/omnibox"
                    android:hint="@string/omnibox_hint"
                    android:textSize="14sp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_4"
                    android:paddingStart="12dp"
                    android:paddingEnd="46dp"
                    android:maxLines="1"
                    android:inputType="textUri|textNoSuggestions"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:selectAllOnFocus="true" />

                <!-- 刷新 / 停止：同一个位置两种形态，跟桌面端 .ow-refresh 同理。
                     padding 8dp → 6dp：它被地址栏的 34dp 卡着抬不高，
                     只能把边距压掉，图标本体才跟旁边那三个 40dp 按钮一样是 22dp。
                     点开地址栏后这个按钮会被「复制 / 分享」浮层盖住，无妨 ——
                     那时用户要的是地址，不是刷新。 -->
                <ImageButton
                    android:id="@+id/btnReload"
                    android:layout_width="34dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_reload"
                    android:contentDescription="@string/content_desc_reload"
                    android:scaleType="centerInside"
                    android:padding="6dp" />
            </FrameLayout>

            <!-- AI 助手。放在地址栏右侧（刷新键再往右），和首页/收藏一样是
                 「一抬拇指就够到」的入口。点它弹出常用 AI 服务商列表，
                 选一个在新标签页打开对应网页版对话，不丢当前页。 -->
            <ImageButton
                android:id="@+id/btnAi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_ai"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:src="@drawable/ic_ai" />
        </LinearLayout>

    </FrameLayout>

    <!-- ============ 更新提示条 ============ -->
    <!--
      夹在顶栏与网页之间：它说的是「应用本身」的状态，不是当前这个网页的状态，
      所以不该挤进网页区内部；而挂到最上面或最下面，又会被系统栏 / 底栏的
      视觉重量压住。放在这里，它是顶栏的自然延伸。

      include 必须显式写 id：不写的话拿不到这一条的引用。它内部所有子 View 的 id
      都挂在同一个命名空间里，很容易误以为 findViewById(R.id.updateBar) 能直接拿到 ——
      拿不到，那样返回的是 null，而这个错要到真机上「更新条死活不出现」才会被发现。
    -->
    <include
        layout="@layout/bar_update"
        android:id="@+id/updateBar" />

    <!-- ============ 网页区 ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!--
          WebView 由代码注入（见 MainActivity#mountMain），不写在布局里。

          写在布局里的话，setContentView 每次执行（也就是每次从弹层返回）
          都会 inflate 出一个新的 WebView 实例，而那个实例不会被 destroy()，
          于是每开关一次弹层就泄漏一个 —— WebView 持有的是 native 内存，
          攒几十个就能把进程拖崩。

          这个容器本身是 {@link top.wuai.nova.RefreshHost}，不是裸 FrameLayout：
          下拉刷新要靠触摸事件拦截，而拦截必须在「包着 WebView 的那一层」做
          （理由见 RefreshHost 的类注释）。实例仍由 MainActivity 持有并搬进搬出：
          既杜绝了泄漏，也保住了页面本身（滚动位置、表单、正在播放的音频）。
        -->
        <top.wuai.nova.RefreshHost
            android:id="@+id/webHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!--
              下拉刷新的指示器。

              用「球」而不是「箭头」：它要从网页上沿滑下来，圆形在任何高度都成立；
              箭头形状在滑动途中会被读成「一个没对齐的图标」。

              隐藏时整体移到本容器上沿之外（负位移），靠 FrameLayout 的裁剪看不见 ——
              而不是用 visibility 切换。用 visibility 的话就没法做出「跟着手指滑下来」
              这件事，那正是下拉刷新唯一的进度反馈。

              小 spinner 与箭头互斥：拉的过程中显示箭头（跟着手指转），
              真开始刷新了换成系统 spinner（由系统负责转，不用自己写动画）。
            -->
            <FrameLayout
                android:id="@+id/refreshBall"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_refresh_ball"
                android:elevation="4dp"
                android:visibility="gone"
                android:alpha="0">

                <ImageView
                    android:id="@+id/refreshArrow"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_reload"
                    android:contentDescription="@string/content_desc_pull_refresh" />

                <ProgressBar
                    android:id="@+id/refreshSpinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/brand"
                    android:visibility="gone" />
            </FrameLayout>
        </top.wuai.nova.RefreshHost>

        <!-- 加载进度。高度 2dp 是桌面端进度条高度令牌 bar-h 的对应值，
             粗了会跟内容抢注意力，细到看不见又等于没有。 -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/brand"
            android:progressBackgroundTint="@android:color/transparent" />

        <!-- 状态条：拼页进度 / 降级提示 / 无图命中。
             桌面端那个 shrink-to-fit 的截断坑在原生里不存在（原生按 layout 算宽），
             但仍然要 maxLines=2，否则一句长的降级原因会把进度条顶下去。 -->
        <TextView
            android:id="@+id/statusStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#E6171A22"
            android:textColor="#F2F4F8"
            android:textSize="12sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- 无图模式的常驻标记。放在地址栏下方而不是状态条里，
             因为它是「当前生效的档位」，不是「刚刚发生的事」，关掉了就不该占地方。 -->
        <TextView
            android:id="@+id/noImageChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="@drawable/chip_pill"
            android:text="@string/status_noimage"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <!--
          强制更新时盖在网页上的遮罩。

          为什么需要这一层：「强制」如果只体现在「× 按钮不见了」，用户照样可以
          刷一整天的网页，只是上面多挂了一行字 —— 那叫提示，不叫强制。
          把网页区盖住、把「继续用旧版」这条路堵上，才对得起 mandatory 这个标记。

          它只盖网页区，不盖顶栏和底栏：地址栏还能看出当前在哪个站，
          底栏还能退出应用。要挡住的是「继续用」，不是「把人关起来」。

          颜色直接写 #A6000000 而不走 @color 令牌：这是一层纯黑遮罩，
          深浅两个主题下都该是同样的黑，走令牌反而要维护两份等值的颜色
          （statusStrip 那处的硬编码也是同一个道理）。
        -->
        <View
            android:id="@+id/updateGuard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A6000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ============ 底栏（两态叠放） ============
         这一行有两种形态，同一行里叠着、滚动时交叉淡入淡出：
           常态   = mobileBar     —— 五格（后退 / 前进 / 标签 / 工具 / 菜单）
           滚动中 = searchCapsule —— 整条换成胶囊搜索框

         为什么搜索框搬到这里（原先是放在顶栏那一行的）：
         底栏隐去时它那 54dp 是留着的（用 INVISIBLE 而不是 GONE，图的是不改布局、
         不推网页），于是屏幕下方多出一条谁也没用的空白。与其让它空着，
         不如把「滚动时唯一还要用的东西」放进去 —— 手指刚划完的地方，
         本来也是拇指最顺的位置。

         行高恒定（54dp）的做法与顶栏原先一样：两个子 View 互相覆盖，
         「行高 = 最高的那个」，胶囊 40dp < 54dp，所以它在 GONE 与 VISIBLE
         之间怎么切都不会改这一行的高度 —— 网页不会被推一下。
    -->
    <FrameLayout
        android:id="@+id/bottomRow"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/surface"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/mobileBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <!--
              四格按钮用 <include> 复用同一份布局。include 上必须显式写 id：
              不写的话被包含布局的根 id（btnBox）会原样冒上来，四个一模一样的 id，
              findViewById 只会拿到第一个 —— 那就是「几个按钮全绑成同一个动作」这种
              能编译能运行、只是完全不对的 bug。
            -->
            <include layout="@layout/item_mb_back" android:id="@+id/item_mb_back" />
            <include layout="@layout/item_mb_forward" android:id="@+id/item_mb_forward" />

            <!-- 中间那个是主按钮：标签数写在图里，尺寸也更大（56dp），
                 跟 Chrome/Safari 的习惯一致 —— 底栏里最重要的操作要一眼可辨。 -->
            <LinearLayout
                android:id="@+id/mbTabs"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_primary_btn"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_tabs"
                    android:contentDescription="@string/mb_tabs" />

                <TextView
                    android:id="@+id/mbTabCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 「工具」格合并了原来的「下载」与「阅读」两格：320dp 机型上底栏每格
            已经贴着 44px 触控下限，减格比加格更值当。有下载任务在跑时，这一格的文字会被
            updateDownloadBadge() 改成「工具 N」并换上品牌色底，提醒「它还在动」。 -->
            <include layout="@layout/item_mb_tools" android:id="@+id/item_mb_tools" />
            <include layout="@layout/item_mb_menu" android:id="@+id/item_mb_menu" />
        </LinearLayout>

        <!--
          滚动态的胶囊搜索框。顶栏整行收起后，搜索入口落到这里。

          刻意用 surface + 品牌色描边（bg_search_capsule），与常态的 omnibox
          （surface_2 灰底无边框）区分开 —— 一眼能看出「现在这一格是搜索状态」。

          40dp 高：底部这一行是拇指的自然落点，比它原先在顶栏时的 34dp 放大一点更好按；
          同时 40 < 54（行高），所以它显隐不会改本行高度。

          初始 gone + alpha=0：不进场时它不该吃掉任何触摸。
          位移由代码给（见 MainActivity#applyReveal），从本行下沿滑进来。
        -->
        <LinearLayout
            android:id="@+id/searchCapsule"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_capsule"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            android:alpha="0">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search_hint" />

            <EditText
                android:id="@+id/capsuleInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:textColor="@color/text"
                android:textColorHint="@color/text_4"
                android:textSize="14sp"
                android:maxLines="1"
                android:inputType="textUri|textNoSuggestions"
                android:imeOptions="actionSearch|flagNoExtractUi" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>