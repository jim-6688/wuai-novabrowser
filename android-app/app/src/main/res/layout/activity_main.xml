<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面。结构与桌面端 [data-layout="mobile"] 下的 shell.html 一致：
    顶：工具栏（搜索 + 地址栏 + 收藏 + AI）；滚动时整行收起。
        内置新标签页上这一行的内容整体隐去（页内已经有搜索框了），
        但行本身留着，页面内容不会因为顶栏有无而上下跳 —— 见 MainActivity#applyChromeFor。
    中：WebView（容器 RefreshHost 负责下拉刷新）+ 加载进度 + 提示条
    底：五格等宽底栏（.mobilebar）；滚动时原位置换成胶囊搜索框（见 bottomRow）

  刻意不给任何硬编码颜色，全部走 @color/*，这样 values-night 一换就整体变深色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- ============ 顶部工具栏 ============
         一行：搜索 + 地址栏 + 收藏 + AI。

         原先这里还有第二行（阅读 / 观影 / 翻译 / AI 四个功能键）。撤掉的理由是
         那一行把「一屏直达」当成了唯一价值，代价却是顶栏常驻 48dp 的厚度 ——
         而那四个功能都在工具箱里有行（sheet_tools 的 toolRead / toolTranslate /
         toolMovie / toolAi），下滑一次就到。顶栏从 96dp 收回 48dp，网页多出一行。

         滚动时这一整块收起（setVisibility(GONE)），高度还给网页。
         内置新标签页上只隐去内容（INVISIBLE），行高保留 —— 那一页页内自带搜索框，
         顶栏再挂一个地址栏就是两个入口，但整行收掉又会让人觉得「上面少了点什么」，
         而且内容会随之上跳。
    -->
    <FrameLayout
        android:id="@+id/topRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp">

        <!--
          这里原来有一条 1dp 的硬分隔线（@color/border）。撤掉，改由 elevation 的
          投影来说「工具栏浮在网页上面」—— 两条一起留着，边上就成了一道双线。

          4dp → 8dp：4dp 的投影在浅色底上几乎看不见（当初那条硬线就是为了补这件事
          才加的），8dp 才有明确的悬浮感。底栏用同一个值，两条看起来才是同一套东西。
        -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶栏那一行：搜索 + 地址栏 + 收藏 + AI。
                 这一行的 id 是 topBar —— 内置新标签页上整套内容会被置为
                 INVISIBLE（见 MainActivity#applyChromeFor），保留它占的高度。 -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp">

                <!-- 搜索入口：点一下聚焦地址栏。原先这里是应用 logo（点开主菜单），
                     现在主菜单移进工具箱（底栏「工具」→ 菜单行），顶栏左端让给搜索 ——
                     地址栏只能覆盖「输入」，而这一格覆盖的是「我想搜点什么」这个起点。 -->
                <ImageButton
                    android:id="@+id/btnSearch"
                    android:layout_width="@dimen/tap_action"
                    android:layout_height="@dimen/tap_action"
                    android:layout_marginEnd="2dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_hint"
                    android:scaleType="centerInside"
                    android:padding="7dp"
                    android:src="@drawable/ic_search_nav" />

                <!-- 地址栏 -->
                <FrameLayout
                    android:id="@+id/omniboxWrap"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1">

                    <EditText
                        android:id="@+id/urlBar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/omnibox"
                        android:hint="@string/omnibox_hint"
                        android:textSize="14sp"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_4"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:maxLines="1"
                        android:inputType="textUri|textNoSuggestions"
                        android:imeOptions="actionGo|flagNoExtractUi"
                        android:selectAllOnFocus="true" />
                </FrameLayout>

                <!-- 收藏（书签）按钮 -->
                <ImageButton
                    android:id="@+id/btnStar"
                    android:layout_width="@dimen/tap_action"
                    android:layout_height="@dimen/tap_action"
                    android:layout_marginStart="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_desc_star"
                    android:scaleType="centerInside"
                    android:padding="7dp"
                    android:src="@drawable/ic_star" />

                <!-- 收藏夹栏的唤出键已撤掉 —— 它收进底栏工具箱里那一格了
                     （sheet_tools 的 toolBmBar）。顶栏每一格都要争宽度，
                     而这一格与左端搜索、右端 AI 相比并不常用，让位给地址栏更值。
                     下面那个 include 出来的 bookmarkBar 本身不动：
                     它是「按需唤出」的那条横栏，唤出入口换了地方，栏还是同一条。 -->

                <!-- AI 助手。原来在顶栏第二行（那一行已撤掉），现在是顶栏最右一格。
                     图标本身就是品牌渐变，与左端的搜索按钮一蓝一绿呼应，一眼能认出
                     「这一格是去别处做一件事」。 -->
                <ImageButton
                    android:id="@+id/btnAi"
                    android:layout_width="@dimen/tap_action"
                    android:layout_height="@dimen/tap_action"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_desc_ai"
                    android:scaleType="centerInside"
                    android:padding="7dp"
                    android:src="@drawable/ic_ai" />
            </LinearLayout>

            <!-- 收藏夹栏。默认 gone —— 它是「按需唤出」的一条，不是常驻的一条。

                 放在 topBar 之后的同一块里，于是滚动时顶栏整块 GONE 的那套逻辑
                 自动带着它一起走，这条栏不用自己再处理一次滚动。

                 横向滚动而不是换行：换行会把这一栏撑高，网页视口跟着缩一截，
                 而「这条栏占多高」是用户点开它的那一刻就已经定下的预期。

                 scrollbars=none：横条的滚动条在移动端只会横在字下面，
                 而这本来也不是一条需要看见滚动条的东西。 -->
            <HorizontalScrollView
                android:id="@+id/bookmarkBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:fillViewport="false"
                android:paddingTop="2dp"
                android:paddingBottom="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/bookmarkBarRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />
            </HorizontalScrollView>

        </LinearLayout>

    </FrameLayout>

    <!-- ============ 更新提示条 ============ -->
    <!--
      夹在顶栏与网页之间：它说的是「应用本身」的状态，不是当前这个网页的状态，
      所以不该挤进网页区内部；而挂到最上面或最下面，又会被系统栏 / 底栏的
      视觉重量压住。放在这里，它是顶栏的自然延伸。

      include 必须显式写 id：不写的话拿不到这一条的引用。它内部所有子 View 的 id
      都挂在同一个命名空间里，很容易误以为 findViewById(R.id.updateBar) 能直接拿到 ——
      拿不到，那样返回的是 null，而这个错要到真机上「更新条死活不出现」才会被发现。
    -->
    <include
        layout="@layout/bar_update"
        android:id="@+id/updateBar" />

    <!-- ============ 网页区 ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!--
          WebView 由代码注入（见 MainActivity#mountMain），不写在布局里。

          写在布局里的话，setContentView 每次执行（也就是每次从弹层返回）
          都会 inflate 出一个新的 WebView 实例，而那个实例不会被 destroy()，
          于是每开关一次弹层就泄漏一个 —— WebView 持有的是 native 内存，
          攒几十个就能把进程拖崩。

          这个容器本身是 {@link top.wuai.nova.RefreshHost}，不是裸 FrameLayout：
          下拉刷新要靠触摸事件拦截，而拦截必须在「包着 WebView 的那一层」做
          （理由见 RefreshHost 的类注释）。实例仍由 MainActivity 持有并搬进搬出：
          既杜绝了泄漏，也保住了页面本身（滚动位置、表单、正在播放的音频）。
        -->
        <top.wuai.nova.RefreshHost
            android:id="@+id/webHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!--
              下拉刷新的指示器。

              用「球」而不是「箭头」：它要从网页上沿滑下来，圆形在任何高度都成立；
              箭头形状在滑动途中会被读成「一个没对齐的图标」。

              隐藏时整体移到本容器上沿之外（负位移），靠 FrameLayout 的裁剪看不见 ——
              而不是用 visibility 切换。用 visibility 的话就没法做出「跟着手指滑下来」
              这件事，那正是下拉刷新唯一的进度反馈。

              小 spinner 与箭头互斥：拉的过程中显示箭头（跟着手指转），
              真开始刷新了换成系统 spinner（由系统负责转，不用自己写动画）。
            -->
            <FrameLayout
                android:id="@+id/refreshBall"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_refresh_ball"
                android:elevation="4dp"
                android:visibility="gone"
                android:alpha="0">

                <ImageView
                    android:id="@+id/refreshArrow"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_reload"
                    android:contentDescription="@string/content_desc_pull_refresh" />

                <ProgressBar
                    android:id="@+id/refreshSpinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/brand"
                    android:visibility="gone" />
            </FrameLayout>
        </top.wuai.nova.RefreshHost>

        <!-- 加载进度。高度 2dp 是桌面端进度条高度令牌 bar-h 的对应值，
             粗了会跟内容抢注意力，细到看不见又等于没有。 -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/brand"
            android:progressBackgroundTint="@android:color/transparent" />

        <!-- 状态条：拼页进度 / 降级提示 / 无图命中。
             桌面端那个 shrink-to-fit 的截断坑在原生里不存在（原生按 layout 算宽），
             但仍然要 maxLines=2，否则一句长的降级原因会把进度条顶下去。

             marginBottom 60dp = 底栏高度：底栏改成压在网页上之后，凡是对 bottom
             对齐的东西都会钻到它底下去（这一条和下面的无图标记都是）。 -->
        <TextView
            android:id="@+id/statusStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="60dp"
            android:background="#E6171A22"
            android:textColor="#F2F4F8"
            android:textSize="12sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- 无图模式的常驻标记。放在地址栏下方而不是状态条里，
             因为它是「当前生效的档位」，不是「刚刚发生的事」，关掉了就不该占地方。 -->
        <TextView
            android:id="@+id/noImageChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="72dp"
            android:background="@drawable/chip_pill"
            android:text="@string/status_noimage"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <!--
          强制更新时盖在网页上的遮罩。

          为什么需要这一层：「强制」如果只体现在「× 按钮不见了」，用户照样可以
          刷一整天的网页，只是上面多挂了一行字 —— 那叫提示，不叫强制。
          把网页区盖住、把「继续用旧版」这条路堵上，才对得起 mandatory 这个标记。

          它只盖网页区，不盖顶栏和底栏：地址栏还能看出当前在哪个站，
          底栏还能退出应用。要挡住的是「继续用」，不是「把人关起来」。

          颜色直接写 #A6000000 而不走 @color 令牌：这是一层纯黑遮罩，
          深浅两个主题下都该是同样的黑，走令牌反而要维护两份等值的颜色
          （statusStrip 那处的硬编码也是同一个道理）。
        -->
        <View
            android:id="@+id/updateGuard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A6000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ============ 底栏（两态叠放） ============
         这一行有两种形态，同一行里叠着、滚动时交叉淡入淡出：
           常态   = mobileBar     —— 五格等宽纯图标（后退 / 主页 / 标签 / 刷新 / 工具）
           滚动中 = searchCapsule —— 整条换成胶囊搜索框

         为什么搜索框搬到这里（原先是放在顶栏那一行的）：
         底栏隐去时它那 60dp 是留着的（用 INVISIBLE 而不是 GONE，图的是不改布局、
         不推网页），于是屏幕下方多出一条谁也没用的空白。与其让它空着，
         不如把「滚动时唯一还要用的东西」放进去 —— 手指刚划完的地方，
         本来也是拇指最顺的位置。

         行高恒定（60dp）的做法与顶栏原先一样：两个子 View 互相覆盖，
         「行高 = 最高的那个」，胶囊 40dp < 60dp，所以它在 GONE 与 VISIBLE
         之间怎么切都不会改这一行的高度 —— 网页不会被推一下。

         60dp 而不是 54dp：五格改成纯图标之后，54dp 上下的余量只剩十来 dp，
         图标贴得太近，反而比带文字时更挤。60dp 给 26dp 的图标留出上下各 17dp
         的呼吸，也刚好是设计板上那一格的高度。
    -->
    <!--
      这一条**压在网页上**，不是把网页推上去的一行。

      「压在网页上」靠上面那个 layout_marginTop="-60dp"：负的外边距让这一条
      从网页区的下沿再往上提 60dp，正好盖住网页最后一条；LinearLayout 里后画的
      兄弟盖在先画的上面，所以它是盖上去而不是把网页挤走。负值必须与 height 相等
      （都是 60dp），改高度时这里要跟着改。

      底色**随形态切**（见 MainActivity#applyBottomBarGround）：
        五格工具栏时 = @color/surface（实底）
        胶囊搜索框时 = @color/surface_translucent（玻璃条）

      为什么不是一直半透明：五格工具栏是常驻的一条，底下永远压着网页，
      半透明时页面文字会从图标缝里透出来，读起来像脏、也像没对齐；
      而滚动态的胶囊是临时浮上来的一块输入区，半透明才有层级感。
      这里写的是初态（工具栏形态）—— 布局加载出来时就是实底，
      不能靠代码来纠正，否则冷启动第一帧会闪一下玻璃条。

      代价说清楚：网页最底下 60dp 会被挡住。所以 MainActivity#injectBarInset
      会给页面补一条同样高度的 padding-bottom，把最后一行还回来。
    -->
    <FrameLayout
        android:id="@+id/bottomRow"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="-60dp"
        android:background="@color/surface"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/mobileBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal">

            <!--
              各格用 <include> 复用同一份布局。include 上必须显式写 id：
              不写的话被包含布局的根 id（btnBox）会原样冒上来，几格一模一样的 id，
              findViewById 只会拿到第一个 —— 那就是「几个按钮全绑成同一个动作」这种
              能编译能运行、只是完全不对的 bug。
            -->
            <include layout="@layout/item_mb_back" android:id="@+id/item_mb_back" />
            <include layout="@layout/item_mb_home" android:id="@+id/item_mb_home" />

            <!--
              中间那格是标签页。它原先是一颗 56dp 的品牌渐变主按钮、图标是白的 ——
              五格改成等宽之后它不再有自己的底色，于是计数徽标（品牌色小胶囊）
              成了这一格唯一的有色元素：标签数的存在感从「一整块蓝」收到「一粒徽标」，
              但「现在开着几个标签」这件事仍然是底栏上唯一被强调的数字。

              徽标挂在 30dp 的图标壳里、贴在图标右上角，而不是挂在这一格上：
              挂在格上会按整格（60dp 高、宽度随屏幕变）定位，它在不同机型上会飘。
              壳要 clipChildren=false，否则超出 30dp 的那半个徽标会被裁掉。
            -->
            <FrameLayout
                android:id="@+id/mbTabs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="@dimen/icon_action"
                    android:layout_height="@dimen/icon_action"
                    android:layout_gravity="center"
                    android:clipChildren="false">

                    <ImageView
                        android:layout_width="@dimen/icon_action"
                        android:layout_height="@dimen/icon_action"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_tabs"
                        android:contentDescription="@string/mb_tabs" />

                    <TextView
                        android:id="@+id/mbTabCount"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:minWidth="16dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:gravity="center"
                        android:text="1"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/badge_on_brand"
                        android:background="@drawable/bg_count_badge"
                        android:translationX="2dp"
                        android:translationY="-3dp" />
                </FrameLayout>
            </FrameLayout>

            <include layout="@layout/item_mb_reload" android:id="@+id/item_mb_reload" />
            <!-- 第五格「工具箱」：弹工具面板（下载 / 阅读 / 翻译 / 观影 / AI /
                 广告拦截 / 主菜单）。顶栏那个工具图标撤掉之后，这里是工具的唯一下沉入口。 -->
            <include layout="@layout/item_mb_tools" android:id="@+id/item_mb_tools" />
        </LinearLayout>

        <!--
          滚动态的胶囊搜索框。顶栏整行收起后，搜索入口落到这里。

          刻意用 surface + 品牌色描边（bg_search_capsule），与常态的 omnibox
          （surface_2 灰底无边框）区分开 —— 一眼能看出「现在这一格是搜索状态」。

          40dp 高：底部这一行是拇指的自然落点，比它原先在顶栏时的 34dp 放大一档更好按，
          也刚好放下与底栏同尺幅的 26dp 放大镜（上下各留 7dp）；
          同时 40 < 60（行高），所以它显隐不会改本行高度。

          初始 gone + alpha=0：不进场时它不该吃掉任何触摸。
          位移由代码给（见 MainActivity#applyReveal），从本行下沿滑进来。
        -->
        <LinearLayout
            android:id="@+id/searchCapsule"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_capsule"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:elevation="6dp"
            android:visibility="gone"
            android:alpha="0">

            <ImageView
                android:id="@+id/capsuleSearch"
                android:layout_width="@dimen/icon_action"
                android:layout_height="@dimen/icon_action"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search_hint" />

            <EditText
                android:id="@+id/capsuleInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:textColor="@color/text"
                android:textColorHint="@color/text_4"
                android:textSize="14sp"
                android:maxLines="1"
                android:inputType="textUri|textNoSuggestions"
                android:imeOptions="actionSearch|flagNoExtractUi" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>