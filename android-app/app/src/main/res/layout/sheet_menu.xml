<?xml version="1.0" encoding="utf-8"?>
<!--
  主菜单。按「浏览 / 工具 / 应用」三组分，每组包进一张卡片（bg_menu_group）。

  加工能力（下载 / 阅读 / 篡改猴 / 广告拦截）都收敛进「工具」一个入口，
  这里只留「去哪 / 看什么」和「应用级」动作，避免一屏平铺十几行。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <include layout="@layout/sheet_head" />

    <TextView
        style="@style/SectionHead"
        android:paddingTop="2dp"
        android:text="浏览" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_menu_group">

        <include layout="@layout/item_menu" android:id="@+id/menuHome" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@drawable/divider_row"
            android:layout_marginStart="48dp" />
        <include layout="@layout/item_menu" android:id="@+id/menuBookmarks" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@drawable/divider_row"
            android:layout_marginStart="48dp" />
        <include layout="@layout/item_menu" android:id="@+id/menuHistory" />
    </LinearLayout>

    <TextView
        style="@style/SectionHead"
        android:text="工具" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_menu_group">

        <include layout="@layout/item_menu" android:id="@+id/menuTools" />
    </LinearLayout>

    <TextView
        style="@style/SectionHead"
        android:text="应用" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_menu_group">

        <include layout="@layout/item_menu" android:id="@+id/menuUpdate" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@drawable/divider_row"
            android:layout_marginStart="48dp" />
        <include layout="@layout/item_menu" android:id="@+id/menuSettings" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@drawable/divider_row"
            android:layout_marginStart="48dp" />
        <include layout="@layout/item_menu" android:id="@+id/menuAbout" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@drawable/divider_row"
            android:layout_marginStart="48dp" />
        <include layout="@layout/item_menu" android:id="@+id/menuExit" />
    </LinearLayout>

    <TextView
        android:id="@+id/aboutVer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_4"
        android:textSize="11.5sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp" />
</LinearLayout>
