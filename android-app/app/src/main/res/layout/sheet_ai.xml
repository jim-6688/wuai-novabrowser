<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 助手窗口（移动端）。与桌面端那个右侧滑出的 AI 面板同一套语义：

    头：sheet_head（标题 + 关闭）
    → 对话区：一块 WebView，占满剩余高度（由代码 new 出来塞进 aiWebHost，
        不写在 XML —— 弹层是靠 setContentView 整体换掉的，写在布局里每次开关
        都会 inflate 出一个永不 destroy 的 WebView，漏 native 内存）。
    → 底：下拉选 AI + 带入当前页；自定义地址（仅自定义项可见）；
        多行输入框；发送 / 清空；一行说明。

  根容器是 SheetPanel：把弹层高度压在可用空间的 82%，让用户还看得见后面被压暗的网页。
  对话区用 0dp + weight=1 吃满剩余高度，minHeight 兜底防止小屏上被底栏挤没。
-->
<top.wuai.nova.SheetPanel xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/sheet_head" />

    <!-- 对话区：占位容器，WebView 由代码注入。 -->
    <FrameLayout
        android:id="@+id/aiWebHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="220dp"
        android:background="@color/bg" />

    <!-- 底部操作区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/aiSelect"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_capsule"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/aiGrab"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_outline"
                android:text="@string/ai_grab"
                android:textColor="@color/text_2"
                android:textSize="12.5sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- 自定义地址：只有下拉选到「自定义…」时才出现。 -->
        <EditText
            android:id="@+id/aiCustomUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:background="@drawable/omnibox"
            android:hint="@string/ai_custom_url_hint"
            android:textColor="@color/text"
            android:textColorHint="@color/text_4"
            android:textSize="13sp"
            android:inputType="textUri|textNoSuggestions"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <EditText
            android:id="@+id/aiText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/omnibox"
            android:hint="@string/ai_text_hint"
            android:textColor="@color/text"
            android:textColorHint="@color/text_4"
            android:textSize="13.5sp"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="6"
            android:scrollbars="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/aiSend"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_solid"
                android:text="@string/ai_send"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aiClear"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_outline"
                android:text="@string/ai_clear"
                android:textColor="@color/text_2"
                android:textSize="13.5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/ai_note"
            android:textColor="@color/text_4"
            android:textSize="10.5sp" />
    </LinearLayout>
</top.wuai.nova.SheetPanel>
