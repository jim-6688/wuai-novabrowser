<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页。从「一个首页输入框 + 三行」扩成八个分组，每个分组包进一张卡片
  （bg_menu_group），与主菜单/工具面板是同一套视觉语言 —— 这是去掉
  「毛坯房感」的关键：不再是二十来行灰字平铺。

  分组头 SectionHead 悬在卡片上方；组内的可点行用 divider_row 分隔；
  「首页地址」这类输入框和「关于」这类纯信息块也放进各自卡片里。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <include layout="@layout/sheet_head" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="200dp"
        android:maxHeight="600dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ 通用 ============ -->
            <TextView
                style="@style/SectionHead"
                android:text="通用" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_menu_group">

                <TextView
                    style="@style/RowTitle"
                    android:text="首页地址" />

                <EditText
                    android:id="@+id/setHomepage"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/omnibox"
                    android:hint="https://"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_4"
                    android:textSize="14sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setSearch" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setUA" />
            </LinearLayout>

            <!-- ============ 个性化 ============
                 原先「主题 / 主题配色 / 网页字号」混在「通用」里。那三项回答的是
                 「这东西长什么样」，而通用那一组回答「它按什么规则工作」——
                 混在一起时，想换主题的人得先在首页地址、搜索引擎里翻一遍。

                 工具箱里原先还有一行「深浅模式」的快捷入口，这次一并撤掉：
                 同一个动作留两处入口，早晚会出现「两处说法不一样」，
                 而且那一行占的是工具面板里最贵的位置。
            -->
            <TextView
                style="@style/SectionHead"
                android:text="个性化" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_menu_group">

                <include layout="@layout/item_menu" android:id="@+id/setTheme" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setAccent" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setFont" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setSwipeUpSearch" />
            </LinearLayout>

            <!-- ============ 阅读增强 ============ -->
            <TextView
                style="@style/SectionHead"
                android:text="阅读增强" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_menu_group">

                <include layout="@layout/item_menu" android:id="@+id/setNoImage" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setAutoPage" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setLoadImages" />
            </LinearLayout>

            <!-- ============ 广告拦截 ============ -->
            <TextView
                style="@style/SectionHead"
                android:text="广告拦截" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_menu_group">

                <!-- 总开关放第一行：它管着下面全部，包括随包内置的那份名单。 -->
                <include layout="@layout/item_menu" android:id="@+id/setAdblock" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setThirdParty" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setRules" />
                <TextView
                    android:id="@+id/setRulesSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_4"
                    android:textSize="11.5sp"
                    android:lineSpacingExtra="3dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp" />
                <include layout="@layout/item_menu" android:id="@+id/setRulesAuto" />
            </LinearLayout>

            <!-- ============ 插件 ============ -->
            <TextView
                style="@style/SectionHead"
                android:text="插件" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_menu_group">

                <!-- 总开关同样放第一行。关掉它已装脚本全部停用，但不用逐个卸载。 -->
                <include layout="@layout/item_menu" android:id="@+id/setPluginsOn" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setPlugins" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setPluginConfirm" />
            </LinearLayout>

            <!-- ============ 下载 ============ -->
            <TextView
                style="@style/SectionHead"
                android:text="下载" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_menu_group">

                <include layout="@layout/item_menu" android:id="@+id/setThreads" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setAutoDownload" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setDlNotify" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setHistoryMax" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setOpenFolder" />
            </LinearLayout>

            <!-- ============ 隐私 ============ -->
            <TextView
                style="@style/SectionHead"
                android:text="隐私与浏览" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_menu_group">

                <include layout="@layout/item_menu" android:id="@+id/setIncognito" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setClearOnExit" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setForceHttps" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setRestore" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setClearCache" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setClear" />
            </LinearLayout>

            <!-- ============ 应用更新 ============ -->
            <TextView
                style="@style/SectionHead"
                android:text="应用更新" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_menu_group">

                <include layout="@layout/item_menu" android:id="@+id/setUpdateAuto" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row" />
                <include layout="@layout/item_menu" android:id="@+id/setUpdateWifi" />
            </LinearLayout>

            <!-- ============ 关于 ============ -->
            <TextView
                style="@style/SectionHead"
                android:text="关于" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_menu_group"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/setEngineNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_2"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="4dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/setStat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_3"
                    android:textSize="11.5sp"
                    android:lineSpacingExtra="4dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/setListSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_4"
                    android:textSize="11.5sp"
                    android:lineSpacingExtra="4dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/divider_row"
                    android:layout_marginStart="16dp" />
                <include layout="@layout/item_menu" android:id="@+id/setAbout" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
