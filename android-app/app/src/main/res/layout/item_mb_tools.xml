<?xml version="1.0" encoding="utf-8"?>
<!-- 底栏按钮模板。与桌面端 .mb-btn 同构：图标在上、10sp 文案在下、等分宽度。
     与 item_mb_back / item_mb_home / item_mb_reload 是同一份结构 —— 底栏每一格
     都必须长得一样，否则等分宽度下会出现「有的格子图标偏上、有的偏下」的错位。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/btnBox"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_mb_cell"
    android:foreground="?android:attr/selectableItemBackground"
    android:elevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/btnIcon"
        android:layout_width="@dimen/mb_icon"
        android:layout_height="@dimen/mb_icon"
        android:contentDescription="@string/content_desc_tools"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/btnText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_2"
        android:maxLines="1"
        android:visibility="gone" />
</LinearLayout>
