<?xml version="1.0" encoding="utf-8"?>
<!--
  弹层头。四种弹层共用：标题 + 一条拖柄 + 右上角那一键。
  拖柄不是装饰 —— 它明确告诉用户「往下拉/往下划可以关掉」，底部弹层没有这个提示
  会让人以为只能点右上角那一键。

  右上角那一键有两种形态，由 MainActivity#openSheet 按布局分派（图标与行为都换）：
  · 工具栏（sheet_tools）→ 齿轮，点它进设置
  · 其余弹层 → ×，点它关闭
  刻意不放两个键：那一角只有一个位置，而多一个「×」在手机上会让弹层显得拥挤。
  工具栏仍可下拉关闭（拖柄还在），所以换成齿轮不把关掉的出路拿走。

  例外是 AI 助手弹层：因为各家 AI 现已要求登录、对话页一展开就需要大空间，
  它在 × 左边多了一枚「全屏」键（sheetExpand，默认 gone，由 showAiSheet 点亮），
  点一下把对话区拉满整屏、再点收回 82% 的常规模样。其余弹层不显示这枚键。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="4dp"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

    <View
        android:id="@+id/sheetGrip"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/seg_track" />

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/sheetGrip"
        android:layout_marginTop="10dp"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/sheetClose"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_close_tab"
        android:padding="7dp"
        android:src="@drawable/ic_close" />

    <!-- 全屏键：默认隐藏，仅 AI 助手弹层在 openSheet 后点亮（见 MainActivity#showAiSheet）。
         其余弹层仍保持「右上角只有一个键」的约定，不挤第二个图标。 -->
    <ImageView
        android:id="@+id/sheetExpand"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignTop="@id/sheetClose"
        android:layout_toStartOf="@id/sheetClose"
        android:layout_marginEnd="4dp"
        android:visibility="gone"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ai_expand"
        android:padding="7dp"
        android:src="@drawable/ic_expand" />
</RelativeLayout>
