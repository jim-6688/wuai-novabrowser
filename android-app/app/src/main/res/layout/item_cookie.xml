<?xml version="1.0" encoding="utf-8"?>
<!--
  一条 Cookie。点整行进「编辑」；右侧的 × 单独删这一条。

  与历史条目不同：Cookie 没有「什么时候、去过几次」这种元数据，
  所以三行里只留名称、值、域名三项，值那行截断显示（值可能很长）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ckName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/ckValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_2"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/ckDomain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_4"
            android:textSize="10.5sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/ckRemove"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:text="×"
        android:textColor="@color/danger"
        android:textSize="22sp" />
</LinearLayout>
