<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用名。与 package.json 的 productName、桌面端 shell.html 的 title 同源。
         改这里不会改到桌面端，两边要一起改。 -->
    <string name="app_name">吾爱Nova浏览器</string>
    <!-- 版本号单点。原先散在若干个字符串字面量里，改版本要改四处，漏一处就对不上。 -->
    <string name="app_version">1.6.15</string>

    <!-- 底栏。现在是五格：后退 / 前进 / 标签 / 工具 / 菜单。
         「内核」那一格早已换掉（移动版只有系统 WebView 真内置，
         给一个只有一个选项的按钮叫「内核选择」等于用假选择骗用户）；
         「下载」「阅读」两格本轮合并成「工具」。 -->
    <string name="mb_back">后退</string>
    <string name="mb_home">主页</string>
    <!-- 标签面板里内置新标签页那一格显示的名字。它的真身是一条
         file:///android_asset/newtab.html 地址，不特判就会把原始路径
         当标题显示出来（2026-10-25 用户报「显示的本地路径代码」）。 -->
    <string name="tab_home">主页</string>
    <string name="mb_reload">刷新</string>
    <string name="mb_tabs">标签</string>
    <string name="mb_tools">工具</string>

    <!-- 下滑浮现的胶囊搜索框。提交恒走 52ta.top 的导航搜索，输入网址也会被
         当成关键词搜 —— 所以 hint 只说「关键词」，不写「或输入网址」（那会骗用户）。 -->
    <string name="search_hint">输入关键词搜索</string>

    <!-- 更新提示条。条上的正文（标题 / 副标题 / 按钮）全部由 UpdateFlow 算出来，
         不进这里 —— 那是会随状态变的文案，写成资源就得在代码里按状态挑资源 id，
         等于把状态判断拆到两处。这里只留两个给读屏软件用的说明。 -->
    <string name="update_icon_desc">更新</string>
    <string name="update_close_desc">暂时隐藏更新提示</string>

    <!-- 状态条 -->
    <string name="status_idle">就绪</string>
    <string name="status_noimage">无图模式</string>
    <string name="status_adblock">已拦截广告</string>

    <!-- 无障碍朗读。工具栏与底栏上的纯图标按钮各有一条 ——
         ImageButton / ImageView 不写 contentDescription 的话，读屏软件会念包名。 -->
    <string name="content_desc_home">回到首页</string>
    <string name="content_desc_reload">刷新 / 停止加载</string>
    <string name="content_desc_back">返回上一页</string>
    <string name="content_desc_tools">打开工具面板</string>
    <string name="content_desc_star">收藏当前页面 / 取消收藏</string>

    <!-- 顶栏左端品牌标识的无障碍标签。写「菜单」而不是「吾爱Nova」：
         这一格点开的是菜单，而 TalkBack 读的是「这一格做什么」，
         读品牌名会让用户以为点进去是关于页。 -->
    <string name="content_desc_brand">菜单</string>
    <string name="content_desc_ai">AI 助手</string>
    <!-- 下拉刷新的指示器球。它是纯装饰性的（刷新本身由手指动作触发，
         没有任何可点的东西），这条说明只给读屏软件用。 -->
    <string name="content_desc_pull_refresh">下拉刷新</string>

    <!-- 弹层标题 -->
    <string name="sheet_tabs">标签页</string>
    <string name="sheet_engine">浏览器内核</string>
    <string name="sheet_read">阅读增强</string>
    <string name="sheet_menu">菜单</string>
    <string name="sheet_tools">工具栏</string>
    <string name="sheet_settings">设置</string>
    <string name="sheet_collapse_tools">收起工具</string>
    <string name="sheet_about">关于</string>
    <string name="sheet_search">搜索引擎</string>
    <string name="sheet_ai">AI 助手</string>
    <!-- AI 助手窗口：内嵌网页对话 -->
    <string name="ai_grab">带入当前页</string>
    <string name="ai_send">发送</string>
    <string name="ai_clear">清空</string>
    <string name="ai_text_hint">输入内容，选好 AI 后点「发送」</string>
    <string name="ai_custom_url_hint">自定义 AI 对话地址（https://…）</string>
    <string name="ai_note">内嵌网页对话 · 不收集密钥</string>
    <string name="ai_empty">先写点内容</string>
    <string name="ai_custom_hint">请填写自定义 AI 对话地址（https://…）</string>
    <string name="ai_opening">正在打开对话…</string>
    <string name="ai_nothing">没有可带入的内容</string>
    <string name="ai_note_fallback">已打开对话页，把内容贴进去即可</string>
    <string name="ai_expand">全屏对话</string>
    <string name="ai_collapse">退出全屏</string>
    <string name="sheet_downloads">下载</string>
    <string name="sheet_rules">广告拦截规则</string>
    <string name="sheet_plugins">篡改猴</string>
    <string name="sheet_siteinfo">网页安全</string>

    <!-- 「内置」徽章。内置脚本是浏览器替用户装上的，列表里要能一眼区分。 -->
    <string name="plugin_builtin">内置</string>
    <string name="sheet_bookmarks">收藏夹</string>

    <!-- 地址栏空的时候显示什么。默认是提示语；停在内置新标签页上时换成
         「新标签页」—— 那一页的真身是一条又长又吓人的 file:///android_asset/…，
         不适合摊在地址栏里。 -->
    <string name="omnibox_hint">搜索或输入网址</string>
    <string name="omnibox_new_tab">新标签页</string>

    <!-- 点开地址栏后弹出的两个动作 -->
    <string name="url_act_copy">复制</string>
    <string name="url_act_share">分享该网站</string>
    <string name="url_copied">已复制网址</string>
    <string name="url_share_title">分享该网站</string>
    <!-- 内置新标签页、空白页这类没有「网站」可言的页面上点这两个按钮时说的话。
         不说「操作失败」—— 什么都没坏，只是这一页没有网址。 -->
    <string name="url_no_site">这一页没有网址</string>

    <!-- 新标签页的三种取值，对应设置里「新标签页」那一行。
         「内置」＝随包自带的这一页（品牌区 + 快捷方式九宫格），
         它与桌面端共用 src/renderer/newtab.html 一份源。 -->
    <string name="ntp_start">内置</string>
    <string name="ntp_homepage">首页</string>
    <string name="ntp_blank">空白</string>
    <string name="ntp_added">已添加</string>

    <string name="action_new_tab">+ 新建标签页</string>
    <string name="action_close_tab">关闭</string>
    <string name="action_close_all">全部关闭</string>
    <string name="action_cancel">取消</string>
    <string name="action_confirm">确定</string>
    <string name="action_exit">退出</string>

    <string name="bookmark_empty">还没有收藏。打开网页后点顶栏的星标即可收藏。</string>
    <string name="bookmark_added">已收藏</string>
    <string name="bookmark_removed">已取消收藏</string>


    <string name="sheet_history">历史</string>
    <string name="history_empty">还没有浏览记录。只记录 http/https 网页，无痕模式下不记。</string>
    <string name="history_visits">%1$d 次</string>

    <string name="zoom_small">小</string>
    <string name="zoom_default">默认</string>
    <string name="zoom_large">大</string>
    <string name="zoom_xl">特大</string>
</resources>