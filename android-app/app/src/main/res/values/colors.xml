<?xml version="1.0" encoding="utf-8"?>
<!--
  Nova 星云 · 颜色令牌。与 src/renderer/shell.css 的 :root 和 [data-theme="dark"]
  逐条对应 —— 两端共用同一套语言，改一边就要改另一边。
  EngineCatalog 引用的 engine_chromium / engine_gecko / engine_trident 必须存在。

  注意：XML 注释里不允许出现连续两个连字符，所以这里只能写「brand」而不能照抄
  CSS 自定义属性的写法。连字符会让 aapt2 直接报错，而它报的是文件名加行号，
  不指具体是哪个词 —— 不好查。
-->
<resources>
    <!-- 品牌。青兰为主、蓝绿为辅；两者之间的 135 度渐变是「星云」母题，
         用在底栏主按钮、选中态、胶囊描边与进度条上。
         shell.css 的 brand / brand-strong / accent -->
    <color name="brand">#2D6BF5</color>
    <color name="brand_strong">#1D52D6</color>
    <color name="accent">#00C8A8</color>

    <!-- 深色模的两支品牌色。深空底上 #2D6BF5 的对比度只有 4.0 上下，
         小字会发飘，所以整支提亮一档；values-night 把上面两个名字
         别名到这里，而不是各自硬写一遍。 -->
    <color name="brand_dark">#5B8BFF</color>
    <color name="brand_strong_dark">#4272E8</color>
    <color name="accent_dark">#2BD9BE</color>

    <!-- 星标（收藏）。金色是「收藏」这个动作在全平台的通识色，
         不借用 warn —— warn 是语义色，哪天警告要换个颜色，
         收藏星会跟着一起变，而这两件事毫无关系。 -->
    <color name="star">#F5A623</color>

    <!-- 品牌色底上的文字。写成一对而不是一个，因为品牌色本身在深浅两模下
         亮度差得远：#2D6BF5 上要白字，#5B8BFF 上白字会发飘、得用深字。
         目前只有底栏那枚标签计数徽标用它；将来任何「品牌底 + 小字」的件
         都该来取这一对，而不是各自挑一个「看着还行」的颜色。 -->
    <color name="badge_on_brand">#FFFFFF</color>
    <color name="badge_on_brand_dark">#0A0D16</color>

    <!-- 内核标识色。shell.css 的 engine 系列 -->
    <color name="engine_chromium">#2D6BF5</color>
    <color name="engine_chromium_dark">#5B8BFF</color>
    <color name="engine_gecko">#FF7139</color>
    <color name="engine_trident">#0A84C6</color>

    <!-- 语义色。深浅两模共用，不随主题覆盖 —— 它们在两种底上都够看，
         覆盖了就等于维护两份。shell.css 的 ok / warn / danger -->
    <color name="ok">#12B981</color>
    <color name="warn">#FF9F0A</color>
    <color name="danger">#FF4D4F</color>

    <!-- 半透明的表面。用途：底栏那一行的玻璃形态（五格胶囊的底、滚动态的
         玻璃条）—— 它压在网页上，网页从它底下穿过去。
         透明度按设计定的 **65%**（A6 ≈ 166/255）。55% 以下，五个图标在花哨的
         页面上就开始看不清；80% 又看不出是玻璃，所以这一档别随手改。 -->
    <color name="surface_translucent">#A6FFFFFF</color>

    <!-- 玻璃件的边缘高光。底栏胶囊的 1dp 描边用。
         不随主题翻转（深浅两模都近白）：玻璃的边缘是「光」，不是「分隔线」——
         跟着主题翻成深色的话，深色模式下那一道线就消失了，胶囊会像没切边的
         一块模糊。对齐设计稿 .mbar 的 rgba(255,255,255,.75)。 -->
    <color name="capsule_edge">#BFFFFFFF</color>

    <!-- 浅色中性。底色偏冷、与品牌蓝同向；卡片靠边框与投影分层，
         不靠加深底色，所以 surface 系列之间只差一档。 -->
    <color name="bg">#F4F6FB</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_2">#EEF1F8</color>
    <color name="surface_3">#E3E8F4</color>
    <color name="border">#E4E8F2</color>
    <color name="border_strong">#CFD6E6</color>
    <!-- 地址栏描边。比 border_strong 再重两档，接近正文黑：
         顶栏是白底，地址栏又是白底，浅灰描边在 1dp 下几乎看不出边界，
         地址栏会「化」在顶栏里。这一支只给输入类控件用，不要拿去当通用分隔线 ——
         分隔线要的是弱，输入框要的是「一眼看到能点」。 -->
    <color name="border_input">#101322</color>
    <color name="text">#101322</color>
    <color name="text_2">#464E63</color>
    <color name="text_3">#6A7288</color>
    <color name="text_4">#9BA3B7</color>

    <!-- 深色中性。换了一整套深空底，不是把浅色反相：
         底色带蓝、与品牌同向，卡片靠一档高一档的 surface 分层。
         shell.css 的深色主题块 -->
    <color name="bg_dark">#0A0D16</color>
    <color name="surface_dark">#131826</color>
    <color name="surface_2_dark">#1A2032</color>
    <color name="surface_3_dark">#232A40</color>
    <color name="border_dark">#232A40</color>
    <color name="border_strong_dark">#333C57</color>
    <color name="border_input_dark">#4A5470</color>
    <color name="text_dark">#F2F5FC</color>
    <color name="text_2_dark">#C4CBDE</color>
    <color name="text_3_dark">#939CB4</color>
    <color name="text_4_dark">#6C7590</color>
</resources>
