<?xml version="1.0" encoding="utf-8"?>
<!--
  底栏胶囊的投影 —— **一层**。

  为什么不交给 elevation：Android 的 elevation 阴影由 View 轮廓投出，范围受父容器
  边界裁切。胶囊所在的 bottomRow 只有 68dp（58 胶囊 + 10 悬浮量），12dp 的 elevation
  大半落在行外，看起来像根本没加阴影。

  这里画一层就够：一块比胶囊大一圈、向下偏移的胶囊形，落在胶囊后面。
  竖向偏移（top 6dp）比四周外扩更重要 —— 光从上方来，影子只该出现在下方；
  横向各扩 3dp 让两端也有落影，底部留 3dp 不贴到行边（否则会在屏幕底沿切出一条硬边）。

  早先试过 5 层同心矩形近似高斯模糊，效果是「更柔」，但底栏这个尺幅上
  一层就够读，层数多了反而显脏。要更柔再说，不要直接加回来。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="3dp"
        android:right="3dp"
        android:top="6dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="@dimen/mb_capsule_radius" />
        </shape>
    </item>

</layer-list>
