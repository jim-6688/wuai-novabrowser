<?xml version="1.0" encoding="utf-8"?>
<!--
  刷新 / 停止。同一个位置两种形态，跟桌面端 .ow-refresh 同理。

  青绿（accent）：和品牌蓝的首页、金色的星标拉开，顶栏一行读过去
  是「蓝 · 金 · 青 · 渐变」，四个入口各有各的颜色，不用读形状就能区分。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp" android:height="22dp"
    android:viewportWidth="20" android:viewportHeight="20">
    <!-- 圆弧+箭头整体占画布 70%（视觉高 13.9），按「视觉高（含描边）16.9 ≈ 22dp」
         统一档放大。同一枚图标也服务主菜单弹层的「刷新」行。 -->
    <group
        android:scaleX="1.09" android:scaleY="1.09"
        android:pivotX="10.15" android:pivotY="9.55">
        <path android:strokeColor="@color/accent" android:strokeWidth="1.56"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:pathData="M16.5,10 a6.5,6.5 0 1,1 -1.9,-4.6" />
        <path android:strokeColor="@color/accent" android:strokeWidth="1.56"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:pathData="M16.8,2.6 V5.6 H13.8" />
    </group>
</vector>
