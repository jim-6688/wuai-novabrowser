<?xml version="1.0" encoding="utf-8"?>
<!--
  收藏（书签）。描边五角星，未收藏时显示。

  放在工具栏地址栏左侧、首页按钮旁边：和首页键共用一段空间，
  两个都是「一抬拇指就够到」的位置，不占底栏六格的触控预算。

  金色，写死在 strokeColor 上（不用 tint）。「已收藏 / 未收藏」两态靠
  **填充与描边**区分，不靠颜色 —— 用颜色区分的话未收藏态就得是灰的，
  而顶栏这一行要的就是彩色图标，一个灰按钮夹在四个彩色中间最扎眼。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp" android:height="22dp"
    android:viewportWidth="20" android:viewportHeight="20">
    <!-- 统一到「视觉高（含描边）16.9 / 画布 20」≈ 22dp —— 这正是五角星改动前
         自己的渲染大小，所以它基本不动，其余图标放大到与它看齐。 -->
    <group
        android:scaleX="0.99" android:scaleY="0.99"
        android:pivotX="10" android:pivotY="9.2">
        <path android:strokeColor="@color/star" android:strokeWidth="1.72"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M10,1.5 L12.0,7.25 L18.08,7.37 L13.23,11.05 L15.0,16.88 L6.6,10 L5.0,16.88 L6.77,11.05 L1.92,7.37 L8.0,7.25 Z" />
    </group>
</vector>
