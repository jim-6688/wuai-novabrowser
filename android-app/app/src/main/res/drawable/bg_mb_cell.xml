<?xml version="1.0" encoding="utf-8"?>
<!--
  底栏每格的底片：一块内缩的圆角小方块（不是整格铺满）。

  为什么要有它：底栏图标原来是「白背景 + 彩色线条」，没有任何承载面，
  五个图标等于直接贴在玻璃条上，压到花哨网页时既没有轮廓也没有层次，
  看着像画上去的。给每格一块比胶囊亮一档的底片 + 2dp 投影之后，
  才有「一颗颗按键浮在托盘上」的实体感 —— 影子来自 View 的 elevation，
  底片负责给 elevation 一个可投影的轮廓。

  为什么用 layer-list + inset 而不是直接给根布局铺满：
  - 格子是 56×46dp 的触控区，铺满的话五块会连成一条通栏色带，
    看起来像底栏被切成了五段，而不是五颗按键；
  - 内缩 4/3dp 之后块与块之间留出缝，才读得出「一颗一颗」。

  圆角 13dp：底片 48×40dp，13dp 接近半高，四角是软圆，与胶囊、地址栏同一种收法
  （本轮把全屏的圆统一到「能圆就圆」）。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="3dp"
        android:left="4dp"
        android:right="4dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/mb_cell" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="@color/mb_cell_edge" />
        </shape>
    </item>
</layer-list>
