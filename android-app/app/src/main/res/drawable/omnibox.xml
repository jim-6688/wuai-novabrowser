<?xml version="1.0" encoding="utf-8"?>
<!-- 地址栏底：白底 + 近黑描边。原来用 surface_2 灰底无边框，在白色顶栏里几乎隐形；
     后来改成 surface（白）底 + border_strong 描边，但浅灰在 1dp 下仍然偏弱。
     现在换成 border_input（近黑，深色模对应提亮的一支），地址栏边界一眼可辨。
     描边是这一支令牌唯一的用处，不要挪去画分隔线。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="@color/border_input" />
</shape>
