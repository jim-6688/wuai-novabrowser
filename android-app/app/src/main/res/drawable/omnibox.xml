<?xml version="1.0" encoding="utf-8"?>
<!-- 地址栏底：白底 + 近黑描边。原来用 surface_2 灰底无边框，在白色顶栏里几乎隐形；
     后来改成 surface（白）底 + border_strong 描边，但浅灰在 1dp 下仍然偏弱。
     现在换成 border_input（近黑，深色模对应提亮的一支），地址栏边界一眼可辨。
     描边是这一支令牌唯一的用处，不要挪去画分隔线。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <!-- 圆角 12dp → 17dp（2026-10-31，去锐角）：地址栏高 34dp，17dp 正好是
         半个身高，两端成标准半圆，与底栏胶囊、滚动态搜索胶囊同一套「胶囊语言」。
         12dp 在 34dp 高的控件上还是「圆角矩形」，和底栏那颗胶囊放在一起
         能看出是两种形状；现在整屏的圆都是同一种收法。 -->
    <corners android:radius="17dp" />
    <stroke android:width="1dp" android:color="@color/border_input" />
</shape>
