<?xml version="1.0" encoding="utf-8"?>
<!--
  标签计数徽标。底栏「标签」格右上角那颗小胶囊。

  为什么不是 chip_pill：那一支是深蓝半透明（#CC1D52D6）的浮层标记，
  挂在网页上用的，半透明是为了不遮住内容。这颗徽标挂在底栏的纯色底上，
  半透明只会让它显得比周围脏；这里是实心品牌色，深浅两个主题各取各的
  brand（深色模下 values-night 把它别名到提亮后的 #5B8BFF）。

  文字颜色不在这里写，由 item 用 @color/badge_on_brand 指定 ——
  品牌色在深浅两模下亮度差得远（#2D6BF5 要白字、#5B8BFF 要深字），
  同一句 textColor 不可能同时成立。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/brand" />
    <corners android:radius="999dp" />
</shape>
