<?xml version="1.0" encoding="utf-8"?>
<!--
  底栏「标签」格的小圆角底：与官网展示的标签徽标同一套背景色 ——
  linear-gradient(135deg, #5B84FF, #3D6BFF 46%, #00B8A2)。

  背景：移动端这一格早先撤掉了自己的底色（见 activity_main.xml 注释），只留一颗
  品牌色计数徽标；如今按官网样式把渐变补回这一格的小圆角底，让「现在开着几个标签」
  重新成为底栏上被强调的一粒彩色按钮，和官网的标签徽标视觉对齐。

  色值直接取官网原始值（不取移动端 brand 令牌）：用户明确要求「官网展示的背景色」，
  且官网在深浅两套主题下品牌渐变都不变，所以这里写死、深浅两模共用一份。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#5B84FF"
        android:centerColor="#3D6BFF"
        android:endColor="#00B8A2" />
    <corners android:radius="8dp" />
</shape>
