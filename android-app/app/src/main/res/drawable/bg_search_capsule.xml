<?xml version="1.0" encoding="utf-8"?>
<!--
  下滑浮现的胶囊搜索框背景。

  圆角做成 full 的一半（22dp，正好是 44dp 高的一半）→ 两端是标准半圆胶囊，
  视觉上和「地址栏 / 底部工具条」区分开，一眼能看出这是一次临时搜索，不是常驻 chrome。

  surface + 1dp border 都用令牌，不硬编码颜色：values-night 一换就整体变深色，
  这是本工程布局的硬规矩（statusStrip 的历史硬编码是例外，不模仿）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="@color/border" />
</shape>
