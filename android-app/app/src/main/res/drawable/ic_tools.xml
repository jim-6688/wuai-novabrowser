<!--
  底栏「工具」图标：三条横线 + 三个滑块，即常见的「调节 / 工具」符号。

  造型与其它图标保持一致：20dp 画布、纯描边（strokeColor 用 #000，真正的颜色由
  根节点的 android:tint 决定）、圆头线帽。这里刻意不写 fillColor ——
  本工程的线性图标全部靠 tint 上色，写了 fill 反而变成实心块，和 ic_back / ic_menu
  不是一套。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp" android:height="20dp"
    android:viewportWidth="20" android:viewportHeight="20"
    android:tint="@color/text_3">
    <path android:strokeColor="#000" android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M3,6 H17 M3,10 H17 M3,14 H17" />
    <path android:strokeColor="#000" android:strokeWidth="1.6"
        android:pathData="M7,6 a1.8,1.8 0 1,0 0.01,0 z" />
    <path android:strokeColor="#000" android:strokeWidth="1.6"
        android:pathData="M13,10 a1.8,1.8 0 1,0 0.01,0 z" />
    <path android:strokeColor="#000" android:strokeWidth="1.6"
        android:pathData="M9,14 a1.8,1.8 0 1,0 0.01,0 z" />
</vector>
