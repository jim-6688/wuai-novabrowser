<?xml version="1.0" encoding="utf-8"?>
<!--
  地址栏「复制 / 分享」浮层的底。surface + 1dp 描边 + 12dp 圆角（设计令牌 r-md）。

  为什么不复用 card.xml（同样是 surface 底）：那张卡没有描边。
  这个浮层飘在顶栏正下方，顶栏也是 surface —— 只靠 elevation 投影的话，
  在深色主题下阴影几乎看不见，浮层与顶栏会连成一片。描边是那个主题下
  唯一还看得见的边界。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke
        android:width="1dp"
        android:color="@color/border_strong" />
    <corners android:radius="12dp" />
</shape>
