    android:tint="@color/text_3">
    <!-- 书签压在一横条上 = 书签栏。

         与 ic_bookmark 刻意分开：那一支是光秃秃一条竖书签，代表「书签列表」；
         这一格点开的是「地址栏下方那一条常驻横栏」，两个动作不同，图标也该不同 ——
         否则顶栏上会出现两个一样的书签图标，一个开列表、一个拉横栏。 -->
    <path android:strokeColor="#000" android:strokeWidth="1.6"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M6.6,2.8 H13.4 V11.6 L10,8.8 L6.6,11.6 Z" />
