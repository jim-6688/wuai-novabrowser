<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限。两条都必须写在主 manifest 里：
      Android 模板只在 src/debug 下放 INTERNET，release 包默认是「没有联网权限」的，
      不显式补上就会装出一个「所有网页都打不开」的浏览器 —— 这个坑很安静：
      构建不报错，启动不报错，只是每页都白屏。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 应用内安装更新包。Android 8.0 起装未知来源的 APK 需要它，
         不声明的话点了安装也会被系统直接拒绝。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.Nova">

        <!-- usesCleartextTraffic：Android 9（API 28）起默认拒绝 http 明文。
             一半中文站点至今仍是 http，不开这个等于把它们全挡在门外。
             这不是「不安全就放开」，而是浏览器类产品本来就该让用户自己选，
             真正的防护在页面的 https 锁与 HSTS 上。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 从别的应用分享链接进来 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          把自己下载好的更新包交给系统安装器的那条通道。

          exported="false" + grantUriPermissions="true" 是这一对的标准写法：
          平时谁也读不到里面的东西，只有在安装那一刻由我们临时把读权限授予安装器。
          安装器是另一个进程 —— 而 Android 7.0 起不允许把 file:// 地址交给别的应用
          （会直接抛 FileUriExposedException），所以这一步没法绕过。

          权限校验的实现在 ApkProvider 里：只放行 update 目录下的 .apk，
          文件名含 / 或 .. 一律拒绝。
        -->
        <provider
            android:name=".ApkProvider"
            android:authorities="top.wuai.nova.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          更新完成自动重启：监听系统「本应用已被替换」的隐式广播。

          exported="false" 只挡其他应用显式发过来的 intent，不影响系统广播投递。
          ACTION_PACKAGE_REPLACED 是 manifest 静态注册也能收到的隐式广播
          （不受 Android 8 后台执行限制），所以哪怕装新版的瞬间旧进程被杀，
          接收器照样能被拉起、把新版本打开。
        -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
    </application>
</manifest>